// Ported from "IB.html". The panel-toggle JS (toggleIBPanel/toggleIBMobile
// etc.) is now the shared ServicePanel component (Prompt 3) — this page
// just supplies its card data and body content. Body HTML is injected via
// set:html from the same strings the original page's inline <script> used,
// to guarantee exact content fidelity rather than hand-retyping ~250 lines
// of nested markup into JSX.
import { Picture, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
