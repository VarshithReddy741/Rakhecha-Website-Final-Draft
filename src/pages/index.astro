  <script>
    // Hero slideshow: infinite loop with cloned end slides, autoplay, and
    // hover-revealed arrows on desktop. Ported verbatim from Home Page.html.
    (function () {
      const section = document.getElementById("hero-slideshow")!;
      const track = document.getElementById("hero-track")!;
      const prevBtn = document.getElementById("hero-prev")!;
      const nextBtn = document.getElementById("hero-next")!;

      const realSlides = Array.from(track.children);
      const firstClone = realSlides[0].cloneNode(true) as HTMLElement;
      const lastClone = realSlides[realSlides.length - 1].cloneNode(true) as HTMLElement;
      firstClone.setAttribute("aria-hidden", "true");
      lastClone.setAttribute("aria-hidden", "true");
      track.appendChild(firstClone);
      track.insertBefore(lastClone, realSlides[0]);

      const slides = Array.from(track.children);
      const realCount = realSlides.length;
      let current = 1;
      let timer: ReturnType<typeof setInterval> | null = null;

      function goTo(index: number, withTransition: boolean) {
        (track as HTMLElement).style.transition = withTransition ? "" : "none";
        (track as HTMLElement).style.transform = "translateX(-" + index * 100 + "%)";
        current = index;
        if (!withTransition) {
          void (track as HTMLElement).offsetWidth;
          (track as HTMLElement).style.transition = "";
        }
      }

      function next() {
        goTo(current + 1, true);
      }
      function prev() {
        goTo(current - 1, true);
      }

      track.addEventListener("transitionend", () => {
        if (current === slides.length - 1) {
          goTo(1, false);
        } else if (current === 0) {
          goTo(realCount, false);
        }
      });

      function startAuto() {
        if (timer) clearInterval(timer);
        timer = setInterval(next, 3000);
      }

      prevBtn.addEventListener("click", () => {
        prev();
        startAuto();
      });
      nextBtn.addEventListener("click", () => {
        next();
        startAuto();
      });

      section.addEventListener("mousemove", (e) => {
        const rect = section.getBoundingClientRect();
        const overLeftHalf = (e as MouseEvent).clientX - rect.left < rect.width / 2;
        prevBtn.classList.toggle("md:opacity-100", overLeftHalf);
        prevBtn.classList.toggle("md:opacity-0", !overLeftHalf);
        nextBtn.classList.toggle("md:opacity-100", !overLeftHalf);
        nextBtn.classList.toggle("md:opacity-0", overLeftHalf);
      });
      section.addEventListener("mouseleave", () => {
        prevBtn.classList.remove("md:opacity-100");
        prevBtn.classList.add("md:opacity-0");
        nextBtn.classList.remove("md:opacity-100");
        nextBtn.classList.add("md:opacity-0");
      });

      goTo(1, false);
      startAuto();
    })();
  </script>

  <script>
    // Animated count-up for the stats strip. Ported verbatim from Home Page.html.
    document.addEventListener("DOMContentLoaded", () => {
      const counters = document.querySelectorAll(".count-up");

      const animateCountUp = (el: Element) => {
        const target = +(el.getAttribute("data-target") || "0");
        const duration = 2000;
        const startTime = performance.now();

        const step = (currentTime: number) => {
          const elapsedTime = currentTime - startTime;
          const progress = Math.min(elapsedTime / duration, 1);
          const easeProgress = 1 - Math.pow(1 - progress, 4);
          const currentValue = Math.floor(easeProgress * target);
          (el as HTMLElement).innerText = String(currentValue);

          if (progress < 1) {
            window.requestAnimationFrame(step);
          } else {
            (el as HTMLElement).innerText = String(target);
          }
        };

        window.requestAnimationFrame(step);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCountUp(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 },
      );

      counters.forEach((counter) => observer.observe(counter));
    });
  </script>
