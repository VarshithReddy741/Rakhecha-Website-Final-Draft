---
// Horizontal expanding-accordion gallery (desktop only) — an editorial,
// hover-to-reveal alternative view of the same service cards rendered by
// ServicePanel below it. Deliberately static/plain-props (no Sanity import
// here): callers just pass the same {id, title, desc, image, bodyHtml}
// items they already fetched, so this component has zero content of its
// own to keep in sync.
export interface GalleryItem {
  id: string;
  title: string;
  desc: string;
  image: string;
  /** Rendered HTML shown in the pop-out panel when a card is clicked. Falls back to `desc` when omitted. */
  bodyHtml?: string;
}

export interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const galleryId = `sag-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="hidden md:block service-accordion-wrap">
  <div class="service-accordion-controls" data-gallery-controls={galleryId}>
    <button type="button" class="service-accordion-arrow" data-gallery-prev aria-label="Scroll left">
      <span class="material-symbols-outlined">chevron_left</span>
    </button>
    <button type="button" class="service-accordion-arrow" data-gallery-next aria-label="Scroll right">
      <span class="material-symbols-outlined">chevron_right</span>
    </button>
  </div>
  <div class="flex service-accordion-gallery hide-scrollbar" data-gallery={galleryId}>
    {
      items.map((item) => (
        <a
          href={`#service-${item.id}`}
          class="service-accordion-card"
          data-panel={item.id}
          aria-label={item.title}
          aria-expanded="false"
        >
          {/* Purely decorative visual layer: absolutely positioned against
              the gallery (not this anchor) and independently transitioned
              in pixels, so it can animate freely without ever changing
              which element the pointer is actually over — see the JS for
              why the anchor above owns hit-testing exclusively. */}
          <span class="service-accordion-card-visual" style={`background-image:url("${item.image}")`}>
            <span class="service-accordion-overlay" />
            <span class="service-accordion-content">
              <span class="service-accordion-title">
                {item.title.split(" ").map((word, i) => (
                  <>
                    {i > 0 && " "}
                    <span class="service-accordion-title-word">{word}</span>
                  </>
                ))}
              </span>
              <span class="service-accordion-bottom">
                <span class="service-accordion-desc">{item.desc}</span>
                <span class="service-accordion-cta">
                  Learn more
                  <span class="material-symbols-outlined text-base">arrow_forward</span>
                </span>
              </span>
            </span>
          </span>
        </a>
      ))
    }
  </div>

  <div class="service-accordion-detail" data-panel-root hidden>
    <button type="button" class="service-accordion-detail-close" data-panel-close aria-label="Close">
      <span class="material-symbols-outlined">close</span>
    </button>
    <div data-panel-content>
      {
        items.map((item) => (
          <div class="hidden" data-panel-body={item.id} set:html={item.bodyHtml ?? `<p class="font-body-md text-body-md text-on-surface-variant">${item.desc}</p>`} />
        ))
      }
    </div>
  </div>
</div>

<style>
  .service-accordion-wrap {
    position: relative;
  }

  .service-accordion-controls {
    position: absolute;
    top: -52px;
    right: 0;
    display: none;
    gap: 0.5rem;
    z-index: 5;
  }
  .service-accordion-controls.is-visible {
    display: flex;
  }

  .service-accordion-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--color-outline-variant, #d5dbe1);
    background: #fff;
    color: var(--color-primary, #123b5d);
    cursor: pointer;
    transition:
      background 0.2s ease,
      opacity 0.2s ease;
  }
  .service-accordion-arrow:hover {
    background: var(--color-surface-container-low, #f0f2f5);
  }
  .service-accordion-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .service-accordion-gallery {
    position: relative;
    width: 100%;
    height: 420px;
    gap: 3px;
    overflow-x: auto;
    scroll-behavior: smooth;
  }

  /* The anchor is the ONLY element that receives pointer events for a card.
     Its flex-basis is set (and changed) with no transition of its own — see
     the JS — so its box, and therefore its hit-testing geometry, is always
     exactly the current target layout, never a mid-animation interpolation.
     It has no visible content of its own; everything you see lives in
     .service-accordion-card-visual below, which is free to animate however
     it likes because it's pointer-events: none. */
  .service-accordion-card {
    /* Deliberately not `position: relative` — it must stay a non-positioned
       flex item so .service-accordion-card-visual below (an absolutely
       positioned child) resolves its containing block up to the gallery
       instead of to this anchor. If this were positioned, the visual layer
       would just track this anchor's own (already-final) box and the whole
       point of decoupling visual animation from hit-testing would be lost. */
    display: block;
    flex: 1 1 0%;
    min-width: 110px;
    border-radius: 3px;
  }

  /* Absolutely positioned against the gallery (the anchor is position:
     static, so it's skipped as a containing block) and driven purely by
     JS-set left/width in pixels, read back from the anchor's own
     already-final geometry each time it changes. That decoupling is what
     lets this layer transition smoothly — including visually overlapping a
     neighboring card mid-animation — without ever being able to steal a
     pointer event, since it's pointer-events: none throughout.
     scale()/box-shadow/filter live here rather than on the anchor for the
     same reason: transforming the actual hit-tested element would move its
     hitbox off its layout box. */
  .service-accordion-card-visual {
    position: absolute;
    top: 0;
    height: 100%;
    overflow: hidden;
    border-radius: 3px;
    background-size: cover;
    background-position: center;
    pointer-events: none;
    transition:
      left 0.6s cubic-bezier(0.22, 0.68, 0, 1),
      width 0.6s cubic-bezier(0.22, 0.68, 0, 1),
      transform 0.6s cubic-bezier(0.22, 0.68, 0, 1),
      box-shadow 0.6s cubic-bezier(0.22, 0.68, 0, 1),
      filter 0.4s ease;
  }

  .service-accordion-card.is-active .service-accordion-card-visual {
    transform: scale(1.015);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.28);
    z-index: 2;
  }

  /* While one card is expanded (hovered or clicked), every other card
     desaturates so the expanded one reads as the focus. */
  .service-accordion-card.is-dimmed .service-accordion-card-visual {
    filter: grayscale(1);
  }

  .service-accordion-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 32, 0.4);
    transition: background 0.6s cubic-bezier(0.22, 0.68, 0, 1);
  }
  .service-accordion-card:hover .service-accordion-overlay,
  .service-accordion-card.is-active .service-accordion-overlay {
    /* Bottom stays dark for the desc/CTA that reveal there; the top stop
       (was 0.05, nearly see-through) is now a light dark tint too, since
       the title lives top-left and needs its own contrast against the
       photo once the overlay's own darkening thins out toward the top. */
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0.35) 100%);
  }

  .service-accordion-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    color: #fff;
    pointer-events: none;
  }

  /* Service name stays pinned top-left (first child of the flex column,
     default start-alignment); desc/CTA are the only part that should still
     sit at the bottom, so they're grouped in their own margin-top:auto
     block rather than the whole content stack sharing justify-content. */
  .service-accordion-title {
    display: block;
    font-family: var(--font-headline-lg);
    font-size: var(--saw-collapsed-size, 15px);
    font-weight: 400;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition:
      font-size 0.4s ease,
      font-weight 0.4s ease;
  }
  .service-accordion-title-word {
    display: block;
  }
  .service-accordion-card:hover .service-accordion-title,
  .service-accordion-card:focus-visible .service-accordion-title,
  .service-accordion-card.is-active .service-accordion-title {
    font-size: 24px;
    font-weight: 700;
  }

  .service-accordion-bottom {
    margin-top: auto;
    display: flex;
    flex-direction: column;
  }
  .service-accordion-card:hover .service-accordion-title-word,
  .service-accordion-card:focus-visible .service-accordion-title-word,
  .service-accordion-card.is-active .service-accordion-title-word {
    display: inline;
  }

  .service-accordion-desc {
    display: block;
    font-family: var(--font-body-sm);
    font-size: 14px;
    line-height: 1.5;
    max-width: 26rem;
    margin-bottom: 1rem;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .service-accordion-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-family: var(--font-cta-text);
    font-size: 14px;
    font-weight: 600;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.5s ease 0.05s,
      transform 0.5s ease 0.05s;
  }

  .service-accordion-card:hover .service-accordion-desc,
  .service-accordion-card:hover .service-accordion-cta,
  .service-accordion-card:focus-visible .service-accordion-desc,
  .service-accordion-card:focus-visible .service-accordion-cta,
  .service-accordion-card.is-active .service-accordion-desc,
  .service-accordion-card.is-active .service-accordion-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .service-accordion-card:focus-visible .service-accordion-overlay {
    /* Bottom stays dark for the desc/CTA that reveal there; the top stop
       (was 0.05, nearly see-through) is now a light dark tint too, since
       the title lives top-left and needs its own contrast against the
       photo once the overlay's own darkening thins out toward the top. */
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0.35) 100%);
  }

  .service-accordion-detail {
    position: relative;
    margin-top: 2rem;
    padding: 2.5rem;
    border-radius: 12px;
    background: var(--color-surface-container-lowest, #f7f8fa);
    border: 1px solid var(--color-outline-variant, #d5dbe1);
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  .service-accordion-detail.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .service-accordion-detail-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: var(--color-on-surface-variant, #444);
    cursor: pointer;
  }
  .service-accordion-detail-close:hover {
    background: var(--color-surface-container-low, #eceff2);
  }
</style>

<script>
  // The expanded card's target width. Non-target cards' widths are derived
  // from this and the gallery's own clientWidth (see restWidth() below),
  // never from their current rendered size.
  const EXPANDED_WIDTH = 440;
  const CARD_GAP = 3; // matches .service-accordion-gallery's gap: 3px
  const MAX_TITLE_SIZE = 24;
  const MIN_TITLE_SIZE = 10;
  const CONTENT_PADDING = 40; // 1.25rem each side, matches .service-accordion-content's padding

  // One shared font size across every collapsed title, not a per-card
  // best-fit — otherwise a card with a short word (e.g. "FPI") renders
  // much larger than a card with a long one (e.g. "Acquisitions"), which
  // reads as uneven/inconsistent. Instead, find the single longest word
  // across the whole gallery and use whatever size lets THAT word fit;
  // every other card then renders at that same size, with room to spare.
  //
  // Available width comes from each card's actual rendered clientWidth,
  // not a fixed constant: cards use flex:1 1 0% at rest, so they stretch
  // to fill whatever room the gallery has, well past the CSS min-width
  // floor — sizing text off that floor left most of the real space unused
  // and text tiny.
  function fitTitles(gallery: HTMLElement) {
    const canvas = document.createElement("canvas");
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const titles = Array.from(gallery.querySelectorAll<HTMLElement>("[data-panel] .service-accordion-title"));
    if (!titles.length) return;

    let smallestFit = MAX_TITLE_SIZE;

    titles.forEach((title) => {
      const words = Array.from(title.querySelectorAll<HTMLElement>(".service-accordion-title-word"));
      const card = title.closest<HTMLElement>("[data-panel]");
      if (!words.length || !card) return;
      const availableWidth = Math.max(0, card.clientWidth - CONTENT_PADDING);
      if (availableWidth <= 0) return;
      const cs = getComputedStyle(title);
      ctx.font = `${cs.fontWeight} ${MAX_TITLE_SIZE}px ${cs.fontFamily}`;
      const longestWordWidth = Math.max(...words.map((w) => ctx.measureText(w.textContent || "").width));
      if (longestWordWidth <= 0) return;
      smallestFit = Math.min(smallestFit, (availableWidth / longestWordWidth) * MAX_TITLE_SIZE);
    });

    const size = Math.max(MIN_TITLE_SIZE, Math.min(MAX_TITLE_SIZE, Math.floor(smallestFit)));
    titles.forEach((title) => title.style.setProperty("--saw-collapsed-size", `${size}px`));
  }

  function triggerFundAnim(root: Element) {
    const els = root.querySelectorAll(".fund-anim");
    if (!els.length) return;
    els.forEach((el) => el.classList.remove("in-view"));
    void (root as HTMLElement).offsetWidth;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        els.forEach((el) => el.classList.add("in-view"));
      });
    });
  }

  function initGallery(gallery: HTMLElement) {
    const cards = Array.from(gallery.querySelectorAll<HTMLElement>("[data-panel]"));
    // Each card's purely decorative counterpart — see the CSS for why this
    // is what actually animates, while the anchor in `cards` snaps to its
    // destination instantly and owns pointer events exclusively.
    const visuals = cards.map((c) => c.querySelector<HTMLElement>(".service-accordion-card-visual")!);
    const id = gallery.dataset.gallery;
    const controls = document.querySelector<HTMLElement>(`[data-gallery-controls="${id}"]`);
    const prevBtn = controls?.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const nextBtn = controls?.querySelector<HTMLButtonElement>("[data-gallery-next]");
    const wrap = gallery.closest<HTMLElement>(".service-accordion-wrap");
    const panelRoot = wrap?.querySelector<HTMLElement>("[data-panel-root]");
    const panelClose = wrap?.querySelector<HTMLElement>("[data-panel-close]");
    if (!controls || !prevBtn || !nextBtn || !wrap || !panelRoot || !panelClose) return;

    // Single, explicit state model: a click-active card takes priority over
    // whatever's currently hovered, and the effective target is always
    // derived fresh from both rather than mutated in place.
    let hoveredId: string | null = null;
    let activeId: string | null = null;

    // The destination geometry is computed directly from the gallery's own
    // width, never from the cards' current (possibly mid-transition) widths.
    // Reading widths off cards while they're animating meant a hover event
    // arriving mid-transition would calculate the next layout from an
    // intermediate size instead of the real idle/expanded geometry — that's
    // what produced the "neighboring card opens first" glitch on middle
    // cards. The gallery container's own clientWidth is stable regardless of
    // what its children are doing mid-animation, so deriving from it keeps
    // every recalculation anchored to the same destination.
    function restWidth(): number {
      return (gallery.clientWidth - EXPANDED_WIDTH - (cards.length - 1) * CARD_GAP) / (cards.length - 1);
    }

    // Copies each anchor's current (already-final — see applyWidths) box
    // onto its visual counterpart, in pixels, so the visual can transition
    // toward it. Called once synchronously after the anchors snap, so it
    // always reads real, settled geometry rather than a value that's
    // itself still animating.
    function syncVisuals() {
      cards.forEach((c, i) => {
        visuals[i].style.left = `${c.offsetLeft}px`;
        visuals[i].style.width = `${c.offsetWidth}px`;
      });
    }

    function applyWidths(targetCard: HTMLElement | null) {
      // Desaturate every other card while one is expanded, so the expanded
      // card reads as the focus of attention.
      cards.forEach((c) => {
        c.classList.toggle("is-dimmed", targetCard !== null && c !== targetCard);
      });

      // The anchors (the elements that actually receive pointer events)
      // have no CSS transition on flex-basis — see .service-accordion-card
      // — so this assignment takes effect immediately, before the browser's
      // next hit test. That's what makes hit-testing deterministic: there
      // is never a frame where an anchor's box is a mid-animation
      // interpolation, only ever the exact current target layout. Only the
      // visual layer (synced below) is left to animate.
      if (!targetCard) {
        cards.forEach((c) => {
          c.style.flex = "";
        });
      } else {
        // Non-target cards shrink to make room for the expanded one, rather
        // than staying at their idle width and letting the row overflow.
        const rest = restWidth();
        cards.forEach((c) => {
          const width = c === targetCard ? EXPANDED_WIDTH : rest;
          c.style.flex = `0 0 ${width}px`;
        });
      }

      syncVisuals();
    }

    // Resolves current hover/active state into the single card that should
    // be expanded right now, then applies it. Called any time either piece
    // of state changes, so every hover/click/leave always recalculates the
    // target from scratch against live state — never against whatever the
    // previous call left mid-animation.
    function render() {
      const targetId = activeId ?? hoveredId;
      const targetCard = targetId ? (cards.find((c) => c.dataset.panel === targetId) ?? null) : null;
      applyWidths(targetCard);
    }

    // First paint: give the visual layer its idle position/size immediately,
    // with no transition — otherwise the browser would animate it in from
    // its default (unset) left/width the instant this script runs.
    visuals.forEach((v) => {
      v.style.transition = "none";
    });
    syncVisuals();
    void gallery.offsetWidth;
    visuals.forEach((v) => {
      v.style.transition = "";
    });

    function openPanel(id: string) {
      panelRoot!.querySelectorAll("[data-panel-body]").forEach((el) => {
        el.classList.toggle("hidden", el.getAttribute("data-panel-body") !== id);
      });
      panelRoot!.hidden = false;
      void panelRoot!.offsetWidth;
      panelRoot!.classList.add("is-open");
      const shown = panelRoot!.querySelector(`[data-panel-body="${id}"]`);
      if (shown) triggerFundAnim(shown);
    }

    function closePanel() {
      panelRoot!.classList.remove("is-open");
      window.setTimeout(() => {
        if (!activeId) panelRoot!.hidden = true;
      }, 500);
    }

    function setActiveCard(card: HTMLElement | null) {
      activeId = card?.dataset.panel ?? null;
      cards.forEach((c) => {
        c.classList.toggle("is-active", c === card);
        c.setAttribute("aria-expanded", String(c === card));
      });
      render();
      if (card && activeId) {
        openPanel(activeId);
      } else {
        closePanel();
      }
    }

    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        hoveredId = card.dataset.panel ?? null;
        render();
      });
      card.addEventListener("focus", () => {
        hoveredId = card.dataset.panel ?? null;
        render();
      });
      card.addEventListener("click", (e) => {
        e.preventDefault();
        setActiveCard(activeId === card.dataset.panel ? null : card);
      });
    });
    gallery.addEventListener("mouseleave", () => {
      hoveredId = null;
      render();
    });
    gallery.addEventListener("focusout", (e) => {
      if (!gallery.contains((e as FocusEvent).relatedTarget as Node)) {
        hoveredId = null;
        render();
      }
    });
    panelClose.addEventListener("click", () => setActiveCard(null));

    function update() {
      const hasOverflow = gallery.scrollWidth > gallery.clientWidth + 1;
      controls!.classList.toggle("is-visible", hasOverflow);
      prevBtn!.disabled = gallery.scrollLeft <= 1;
      nextBtn!.disabled = gallery.scrollLeft >= gallery.scrollWidth - gallery.clientWidth - 1;
    }

    prevBtn.addEventListener("click", () => {
      gallery.scrollBy({ left: -gallery.clientWidth * 0.6, behavior: "smooth" });
    });
    nextBtn.addEventListener("click", () => {
      gallery.scrollBy({ left: gallery.clientWidth * 0.6, behavior: "smooth" });
    });

    gallery.addEventListener("scroll", update);
    window.addEventListener("resize", update);
    // Expanding a card on hover/click changes scrollWidth, so re-check then too.
    gallery.addEventListener("transitionend", update);
    update();

    // Bug fix: once a card is expanded, the row overflows horizontally —
    // and a horizontally-scrollable element with no vertical overflow of
    // its own will silently swallow the next plain (vertical) mouse-wheel
    // scroll into its own scrollLeft instead of letting the page scroll,
    // which reads as "scrolling stopped working" the moment the cursor is
    // over a card. Forward genuinely-vertical wheel input to the page
    // ourselves; only let a real horizontal gesture (trackpad/shift-wheel,
    // deltaX already dominant) move the gallery's own scroll position.
    //
    // behavior must be explicit "instant": html has scroll-behavior:smooth
    // globally, and scrollBy()'s default "auto" behavior honors that — so
    // every individual wheel tick (a scroll gesture fires dozens of these)
    // was starting its own smooth-scroll animation and cutting off the
    // previous one, which is what made this feel like it was only
    // scrolling "a little" at a time instead of tracking the gesture.
    gallery.addEventListener(
      "wheel",
      (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          e.preventDefault();
          window.scrollBy({ top: e.deltaY, behavior: "instant" });
        }
      },
      { passive: false },
    );

    fitTitles(gallery);
    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        fitTitles(gallery);
        // The gallery's width changed, so the expanded/rest geometry
        // (derived from it) needs recalculating — re-run the same
        // hover/active resolution rather than leaving stale pixel values on
        // the visual layer.
        render();
      }, 150);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach(initGallery);
</script>
