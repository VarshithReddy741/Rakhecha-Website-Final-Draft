              <h4 class="font-label-bold text-label-bold text-primary uppercase tracking-wide mb-1">Excellence</h4>
              <p class="font-body-sm text-body-sm text-on-surface-variant leading-snug">A relentless pursuit of superior outcomes, refining our craft to deliver lasting value.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Leadership Team -->
    <section class="py-14 bg-surface-yellow-light scroll-mt-24" id="our-leadership">
