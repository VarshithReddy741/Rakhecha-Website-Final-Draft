<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">02</span><div><p class="font-label-bold text-primary">Financial analysis/credit assessment</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">03</span><div><p class="font-label-bold text-primary">Business model/industry analysis</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">04</span><div><p class="font-label-bold text-primary">Debt servicing/cash flow assessment</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">05</span><div><p class="font-label-bold text-primary">Financial projections</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">06</span><div><p class="font-label-bold text-primary">Identification of lending institutions</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">07</span><div><p class="font-label-bold text-primary">Documentation support</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">08</span><div><p class="font-label-bold text-primary">Coordination with lenders</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">09</span><div><p class="font-label-bold text-primary">Presentation support</p></div></div>
</div>
</div>
<div class="fund-anim fund-anim-4 mt-8 pt-6 border-t border-primary-light/15">
<h4 class="font-label-bold text-base font-bold text-primary-light mb-6 uppercase tracking-wider">Who should use this</h4>
<ul class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
<li class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">01</span><p class="font-body-sm text-on-surface-variant">Businesses seeking working/growth capital</p></li>
<li class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">02</span><p class="font-body-sm text-on-surface-variant">Companies approaching banks/NBFCs</p></li>
<li class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">03</span><p class="font-body-sm text-on-surface-variant">Startups raising venture debt</p></li>
<li class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">04</span><p class="font-body-sm text-on-surface-variant">Companies refinancing debt</p></li>
<li class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">05</span><p class="font-body-sm text-on-surface-variant">Businesses seeking structured/private credit</p></li>
</ul>
</div>
`,
};
---

<BaseLayout
  title="Investment Banking Hub - Rakhecha Finserv"
  description="Rakhecha Finserv's investment banking team advises on fundraising, IPO listings, valuation, M&A, secondary deals, FPI access, and credit papers to unlock your next stage of growth."
  bodyClass="bg-white text-on-surface font-body-md antialiased min-h-screen flex flex-col"
>
  <Header />

  <main class="flex-grow flex flex-col">
    <!-- Hero Section -->
    <section class="relative h-screen min-h-[600px] flex items-start md:items-center justify-start overflow-hidden">
      <div class="absolute inset-0 z-0">
        <Picture
          src={ibHeroDesktop}
          alt="Distinctive glass skyscraper with an observation deck against a clear sky"
          class="hidden md:block w-full h-full object-cover"
          widths={[768, 1280, 1920]}
          sizes="100vw"
          formats={["webp"]}
          fallbackFormat="webp"
          loading="eager"
        />
        <Picture
          src={ibHeroMobile}
          alt="Rock climber scaling a sunlit cliff face"
          class="md:hidden w-full h-full object-cover object-bottom"
          widths={[480, 768]}
          sizes="100vw"
          formats={["webp"]}
          fallbackFormat="webp"
          loading="eager"
        />
      </div>
      <div class="relative z-10 w-full max-w-container-max px-margin-mobile md:px-margin-desktop pt-[24vh] md:pt-0">
        <h1 class="text-display-lg font-display-lg text-primary mb-6 max-w-4xl">Unlocking the Next Stage of Growth.</h1>
        <div class="flex gap-4"></div>
      </div>
    </section>
    <!-- Services Interactive Section -->
    <section class="py-section-gap bg-white relative z-20 -mt-20">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <ServicePanel items={ibItems} columns={3} expandedHeight="h-[300px]" expandedScale={false}>
          <Fragment slot="panel-fundraising">
            <div set:html={ibBodies.fundraising} />
          </Fragment>
          <Fragment slot="panel-ipo">
            <div set:html={ibBodies.ipo} />
          </Fragment>
          <Fragment slot="panel-valuation">
            <div set:html={ibBodies.valuation} />
          </Fragment>
          <Fragment slot="panel-ma">
            <div set:html={ibBodies.ma} />
          </Fragment>
          <Fragment slot="panel-secondary">
            <div set:html={ibBodies.secondary} />
          </Fragment>
          <Fragment slot="panel-fpi">
            <div set:html={ibBodies.fpi} />
          </Fragment>
          <Fragment slot="panel-credit">
            <div set:html={ibBodies.credit} />
          </Fragment>
        </ServicePanel>
      </div>
    </section>
    <!-- Contact CTA -->
    <section class="py-14 md:py-20 px-margin-mobile md:px-margin-desktop">
      <div class="max-w-container-max mx-auto">
        <div class="bg-primary text-on-primary rounded-xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
          <div class="max-w-xl">
            <h2 class="font-headline-lg text-headline-lg mb-2">Ready to Navigate Global Capital Markets?</h2>
            <p class="font-body-md text-body-md text-primary-fixed opacity-90">Speak with our team to discuss how our investment banking expertise can serve your goals.</p>
          </div>
          <a href="/contact-us/" class="bg-secondary-fixed text-on-secondary-fixed font-cta-text text-cta-text px-6 py-3 rounded-lg hover:bg-secondary-fixed-dim transition-colors whitespace-nowrap inline-block text-center">Contact Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
