  <script>
    // Cycles a highlight clockwise through the four value pills, and drives
    // the circular progress ring alongside it. Ported verbatim from About us.html.
    (function () {
      const rows = document.querySelectorAll("#core-values-section .value-row");
      if (!rows.length) return;
      const ring = document.getElementById("values-ring-progress");
      const circumference = 295.31;
      const order = [0, 1, 3, 2];
      let step = 0;

      function highlight() {
        const activeIdx = order[step];
        rows.forEach((row, i) => {
          const icon = row.querySelector(".value-icon");
          const pill = row.querySelector(".value-pill");
          if (i === activeIdx) {
            icon?.classList.add("scale-110", "ring-4", "ring-primary/30", "shadow-lg");
            pill?.classList.add("scale-[1.02]", "border-primary", "shadow-lg", "bg-primary-container/40");
          } else {
            icon?.classList.remove("scale-110", "ring-4", "ring-primary/30", "shadow-lg");
            pill?.classList.remove("scale-[1.02]", "border-primary", "shadow-lg", "bg-primary-container/40");
          }
        });
        if (ring) {
          const frac = (step + 1) / rows.length;
          if (step === 0) {
            (ring as unknown as SVGElement).style.transition = "none";
            (ring as unknown as SVGElement).style.strokeDashoffset = String(circumference);
            ring.getBoundingClientRect();
            (ring as unknown as SVGElement).style.transition = "stroke-dashoffset 1.2s ease-in-out";
          }
          requestAnimationFrame(function () {
            (ring as unknown as SVGElement).style.strokeDashoffset = String(circumference * (1 - frac));
          });
        }
        step = (step + 1) % rows.length;
      }

      highlight();
      setInterval(highlight, 1500);
    })();
  </script>

  <script>
    // Animated count-up for the stats strip. Ported verbatim from Home Page.html.
    document.addEventListener("DOMContentLoaded", () => {
      const counters = document.querySelectorAll(".count-up");

      const animateCountUp = (el: Element) => {
        const target = +(el.getAttribute("data-target") || "0");
        const duration = 2000;
        const startTime = performance.now();

        const step = (currentTime: number) => {
          const elapsedTime = currentTime - startTime;
          const progress = Math.min(elapsedTime / duration, 1);
          const easeProgress = 1 - Math.pow(1 - progress, 4);
          const currentValue = Math.floor(easeProgress * target);
          (el as HTMLElement).innerText = String(currentValue);

          if (progress < 1) {
            window.requestAnimationFrame(step);
          } else {
            (el as HTMLElement).innerText = String(target);
          }
        };

        window.requestAnimationFrame(step);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCountUp(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 },
      );

      counters.forEach((counter) => observer.observe(counter));
    });
  </script>
