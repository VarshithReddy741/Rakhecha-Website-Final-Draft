---
// Card data and expanded-panel content now come from Sanity (`service`
// documents with businessLine: "investment-banking"), editable/addable in
// Studio without a code change. The Active Secondary Inventory table +
// Ecosystem Support list under "Secondary Deals" stay hardcoded below —
// a bespoke, illustrative block, not part of the editable content.
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ServicePanel from "../components/ServicePanel.astro";
import ServiceAccordionGallery from "../components/ServiceAccordionGallery.astro";
import ServiceScrollRow from "../components/ServiceScrollRow.astro";
