---
// Ported from "Apply for a role page.html". The job header used to be
// hardcoded to "Senior Manager - Legal & Compliance" regardless of which
// real job someone clicked "Apply" for on /careers/[slug]/ — every
// application landed in job_applications tagged with that fake job. This
// is now a dynamic route that fetches the real job from Sanity by slug,
// same pattern as /careers/[slug].astro.
//
// Fix (per prompt): city dropdown only had Mumbai/Delhi/Bangalore. Added
// Kolkata (company HQ) and kept it a <select> rather than converting to
// free text, since a constrained list is easier to route/filter on later
// and free text would be a bigger UX change than asked for.
import { sanityClient, queries, type Job } from "../../../lib/sanity";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch<{ slug: string }[]>(queries.allJobSlugs);
  return slugs.map((j) => ({ params: { slug: j.slug } }));
}

const { slug } = Astro.params;
const job = await sanityClient.fetch<Job | null>(queries.jobBySlug, { slug });
if (!job) return Astro.redirect("/404");

const { title, jobId, location, employmentType, experience } = job;
---

<BaseLayout
  title={`Apply — ${title} | Rakhecha Finserv`}
  description={`Apply for ${title} at Rakhecha Finserv by submitting your details and resume through our online job application form.`}
  noindex
  bodyClass="min-h-screen flex flex-col"
>
  <Header />

  <main class="flex-grow container mx-auto px-margin-desktop py-8 max-w-4xl">
    <!-- Job Header Section -->
    <div class="bg-surface-pure rounded-lg p-8 mb-8 shadow-sm border border-outline-variant/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-2xl font-bold text-on-surface">{title}</h1>
          <span class="bg-surface-container text-on-surface-variant text-xs px-2 py-1 rounded-full font-medium">Job ID: {jobId}</span>
        </div>
        <div class="flex flex-wrap gap-4 text-sm text-on-surface-variant">
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            {employmentType}
          </div>
          <div class="flex items-center gap-1">{location}</div>
          <div class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
            {experience}
          </div>
        </div>
      </div>
      <a href={`/careers/${slug}/`} class="px-4 py-2 border border-outline rounded-4 text-primary font-medium hover:bg-surface-container transition-colors inline-block text-center">See Job Details</a>
    </div>
    <!-- Application Form -->
    <div class="bg-surface-pure rounded-lg p-8 shadow-sm border border-outline-variant/30">
      <!-- method/action are a no-JS fallback only (posts to the JSON API
           instead of leaking form data into a GET query string); the real
           submission always goes through the fetch() handler below. -->
      <form id="applyForm" action="/api/careers-apply" class="space-y-6" method="POST">
        <input type="hidden" name="jobId" value={jobId} />
        <input type="hidden" name="jobTitle" value={title} />
        <p id="applyFormError" class="hidden text-sm text-error" role="alert"></p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="form-label" for="firstName">First Name<span class="required-asterisk">*</span></label>
            <input class="form-input" id="firstName" name="firstName" placeholder="First Name" required type="text" />
          </div>
          <div>
            <label class="form-label" for="lastName">Last Name<span class="required-asterisk">*</span></label>
            <input class="form-input" id="lastName" name="lastName" placeholder="Last Name" required type="text" />
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="form-label" for="contactNumber">Contact Number<span class="required-asterisk">*</span></label>
            <div class="flex">
              <div class="flex-shrink-0 relative">
                <select class="form-select rounded-r-none border-r-0 pl-3 pr-8 w-24" id="countryCode" name="countryCode">
                  <option value="+91">🇮🇳 +91</option>
                </select>
              </div>
              <input class="form-input rounded-l-none" id="contactNumber" name="contactNumber" placeholder="" required type="tel" />
              <button class="ml-2 px-3 py-2 border border-outline-variant rounded-4 text-primary hover:bg-surface-container" type="button">+</button>
            </div>
          </div>
          <div>
            <label class="form-label" for="email">Email Address<span class="required-asterisk">*</span></label>
            <div class="flex">
              <div class="flex-shrink-0 flex items-center justify-center px-3 border border-r-0 border-outline-variant rounded-l-4 bg-surface-container/30 text-on-surface-variant">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
              </div>
              <input class="form-input rounded-l-none" id="email" name="email" placeholder="Email Address" required type="email" />
              <button class="ml-2 px-3 py-2 border border-outline-variant rounded-4 text-primary hover:bg-surface-container" type="button">+</button>
            </div>
          </div>
        </div>
        <!-- Location (fix: Kolkata added as company HQ; list kept as a
             constrained <select> rather than free text) -->
        <div>
          <label class="form-label" for="currentLocation">Current Location<span class="required-asterisk">*</span></label>
          <select class="form-select" id="currentLocation" name="currentLocation" required>
            <option disabled selected value="">City</option>
            <option value="kolkata">Kolkata</option>
            <option value="mumbai">Mumbai</option>
            <option value="delhi">Delhi</option>
            <option value="bangalore">Bangalore</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label class="form-label">Total years of experience<span class="required-asterisk">*</span></label>
          <div class="flex items-center gap-2 mb-3">
            <div class="relative inline-block w-10 mr-2 align-middle select-none transition duration-200 ease-in">
              <input class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer border-outline-variant" id="isFresher" name="isFresher" type="checkbox" />
              <label class="toggle-label block overflow-hidden h-5 rounded-full bg-outline-variant/30 cursor-pointer" for="isFresher"></label>
            </div>
            <span class="text-sm text-on-surface-variant">I am a fresher</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <select aria-label="Years" class="form-select" id="experienceYears" name="experienceYears">
              <option disabled selected value="">Years</option>
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="6">6</option>
            </select>
            <select aria-label="Months" class="form-select" id="experienceMonths" name="experienceMonths">
              <option disabled selected value="">Months</option>
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2">2</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="form-label" for="currentCtc">Current CTC (Annual) <span class="text-outline font-normal">(Optional)</span></label>
            <div class="flex relative">
              <span class="inline-flex items-center px-3 border border-r-0 border-outline-variant rounded-l-4 bg-surface-container/30 text-on-surface-variant text-sm">INR</span>
              <input class="form-input rounded-l-none pl-3" id="currentCtc" name="currentCtc" placeholder="450,000" type="text" />
            </div>
          </div>
          <div>
            <label class="form-label" for="expectedCtc">Expected CTC (Annual) <span class="text-outline font-normal">(Optional)</span></label>
            <div class="flex relative">
              <span class="inline-flex items-center px-3 border border-r-0 border-outline-variant rounded-l-4 bg-surface-container/30 text-on-surface-variant text-sm">INR</span>
              <input class="form-input rounded-l-none pl-3" id="expectedCtc" name="expectedCtc" placeholder="850,000" type="text" />
            </div>
          </div>
        </div>
        <div>
          <label class="form-label" for="resume">Resume <span class="required-asterisk">*</span></label>
          <label
            id="resumeDropzone"
            for="resume"
            class="block border-2 border-dashed border-outline-variant/50 rounded-lg p-8 text-center bg-surface-container/30 hover:bg-surface-container/50 transition-colors cursor-pointer"
          >
            <p id="resumeDropzoneText" class="text-on-surface font-medium mb-1">Upload your resume or drag and drop it here</p>
            <p class="text-sm text-on-surface-variant">PDF, DOC, or DOCX — up to 5MB</p>
          </label>
          <input
            accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            class="sr-only"
            id="resume"
            name="resume"
            required
            type="file"
          />
          <p id="resumeError" class="hidden text-sm text-error mt-2" role="alert"></p>
        </div>
        <div>
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              class="mt-0.5 h-4 w-4 shrink-0 rounded border border-outline-variant/30 text-primary focus:ring-primary"
              id="consentGiven"
              name="consentGiven"
              required
              type="checkbox"
            />
            <span class="text-sm text-on-surface-variant leading-relaxed">
              I consent to Rakhecha Finserv collecting and using my personal data (including the uploaded resume)
              for recruitment purposes, in accordance with the
              <a class="text-primary underline hover:no-underline" href="/privacy-policy/">Privacy Policy</a>.
            </span>
          </label>
        </div>
        <div class="pt-6 border-t border-outline-variant/30 flex justify-end">
          <button id="submitButton" class="bg-black text-white px-8 py-3 rounded-4 font-medium hover:bg-gray-800 transition-colors disabled:opacity-60 disabled:cursor-not-allowed" type="submit">Submit Application</button>
        </div>
      </form>
    </div>
  </main>

  <Footer />

  <script>
    const MAX_RESUME_BYTES = 5 * 1024 * 1024;
    const ALLOWED_RESUME_EXTENSIONS = [".pdf", ".doc", ".docx"];

    const form = document.querySelector<HTMLFormElement>("#applyForm")!;
    const resumeInput = document.querySelector<HTMLInputElement>("#resume")!;
    const resumeDropzone = document.querySelector<HTMLLabelElement>("#resumeDropzone")!;
    const resumeDropzoneText = document.querySelector<HTMLParagraphElement>("#resumeDropzoneText")!;
    const resumeError = document.querySelector<HTMLParagraphElement>("#resumeError")!;
    const formError = document.querySelector<HTMLParagraphElement>("#applyFormError")!;
    const submitButton = document.querySelector<HTMLButtonElement>("#submitButton")!;

    function validateResumeFile(file: File | undefined): string | null {
      if (!file) return "Attach your resume.";
      const extension = file.name.slice(file.name.lastIndexOf(".")).toLowerCase();
      if (!ALLOWED_RESUME_EXTENSIONS.includes(extension)) {
        return "Resume must be a .pdf, .doc, or .docx file.";
      }
      if (file.size > MAX_RESUME_BYTES) {
        return "Resume must be 5MB or smaller.";
      }
      return null;
    }

    function setResumeError(message: string | null) {
      resumeError.textContent = message ?? "";
      resumeError.classList.toggle("hidden", !message);
      resumeDropzone.classList.toggle("border-error", Boolean(message));
    }

    function setFormError(message: string | null) {
      formError.textContent = message ?? "";
      formError.classList.toggle("hidden", !message);
    }

    resumeInput.addEventListener("change", () => {
      const file = resumeInput.files?.[0];
      const error = validateResumeFile(file);
      setResumeError(error);
      resumeDropzoneText.textContent = file && !error ? file.name : "Upload your resume or drag and drop it here";
    });

    resumeDropzone.addEventListener("dragover", (event) => {
      event.preventDefault();
      resumeDropzone.classList.add("border-primary");
    });
    resumeDropzone.addEventListener("dragleave", () => {
      resumeDropzone.classList.remove("border-primary");
    });
    resumeDropzone.addEventListener("drop", (event) => {
      event.preventDefault();
      resumeDropzone.classList.remove("border-primary");
      const file = event.dataTransfer?.files?.[0];
      if (file) {
        resumeInput.files = event.dataTransfer!.files;
        resumeInput.dispatchEvent(new Event("change"));
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      setFormError(null);

      const resumeValidationError = validateResumeFile(resumeInput.files?.[0]);
      setResumeError(resumeValidationError);
      if (resumeValidationError) return;

      submitButton.disabled = true;
      submitButton.textContent = "Submitting...";

      try {
        const response = await fetch("/api/careers-apply", {
          method: "POST",
          body: new FormData(form),
        });
        const payload = await response.json();

        if (!response.ok || !payload.success) {
          setFormError(payload.errors?._form ?? "We couldn't submit your application. Please check the form and try again.");
          if (payload.errors?.resume) setResumeError(payload.errors.resume);
          submitButton.disabled = false;
          submitButton.textContent = "Submit Application";
          return;
        }

        window.location.href = "/careers/apply-success/";
      } catch {
        setFormError("Something went wrong. Please check your connection and try again.");
        submitButton.disabled = false;
        submitButton.textContent = "Submit Application";
      }
    });
  </script>
</BaseLayout>

<style>
  /* Ported from the source's theme('colors.x') / theme('fontFamily.x')
     calls — Tailwind v3's dot-path theme() syntax, which v4 replaces with
     CSS custom properties (var(--color-x)). theme('borderRadius.4') had no
     matching key in the original tailwind-config.js either (no "4" size),
     so it silently produced no rounding there; that's reproduced here by
     just omitting border-radius rather than guessing a value. */
  body {
    background-color: var(--color-surface);
    color: var(--color-on-surface);
    font-family: var(--font-body-md);
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-headline-md);
  }
  .form-input,
  .form-select {
    border-color: var(--color-outline-variant);
    padding: 0.75rem 1rem;
    width: 100%;
    transition:
      border-color 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out;
  }
  .form-input:focus,
  .form-select:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 1px var(--color-primary);
    outline: none;
  }
  .form-label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-on-surface-variant);
  }
  .required-asterisk {
    color: var(--color-error);
    margin-left: 0.25rem;
  }
</style>
