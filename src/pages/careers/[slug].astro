---
// Ported from "Job detail.html".
import { sanityClient, queries, type Job } from "../../lib/sanity";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch<{ slug: string }[]>(queries.allJobSlugs);
  return slugs.map((j) => ({ params: { slug: j.slug } }));
}

const { slug } = Astro.params;
const job = await sanityClient.fetch<Job | null>(queries.jobBySlug, { slug });
if (!job) return Astro.redirect("/404");

const { title, jobId, location, employmentType, experience, description, responsibilities, qualifications } = job;
const metaDescription = `${title} — a ${employmentType.toLowerCase()} role at Rakhecha Finserv in ${location}, requiring ${experience} of experience.`;
---

<BaseLayout
  title={`${title} | Careers at Rakhecha Finserv`}
  description={metaDescription}
  bodyClass="antialiased font-sans bg-surface"
>
  <Header />
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
    <section class="mb-12">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-4 mb-4">
            <h1 class="text-3xl sm:text-4xl font-serif font-bold text-primary">{title}</h1>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-surface-container-high text-on-surface">Job ID: {jobId}</span>
          </div>
          <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-sm text-on-surface-variant">
            <div class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base">location_on</span>
              <span>{location}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base">work</span>
              <span>{employmentType}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base">history</span>
              <span>{experience}</span>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-4 shrink-0 mt-4 lg:mt-0">
          <a href="/careers/" class="px-6 py-2.5 border border-outline text-primary rounded-md font-medium hover:bg-surface-container transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 inline-block text-center">See all jobs</a>
          <a href="/careers/apply/" class="px-6 py-2.5 bg-primary text-on-primary rounded-md font-medium hover:bg-primary/90 transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 shadow-sm inline-block text-center">Apply</a>
        </div>
      </div>
    </section>
    <div class="flex flex-col lg:flex-row gap-12">
      <section class="flex-1">
        <div class="prose prose-sm sm:prose-base prose-blue max-w-none text-on-surface-variant space-y-6">
          <p>{description}</p>
          {
            responsibilities.length > 0 && (
              <>
                <h3 class="text-lg font-semibold text-primary mt-8 mb-4">Responsibilities</h3>
                <ul class="list-disc pl-5 space-y-3">
                  {responsibilities.map((item: string) => <li>{item}</li>)}
                </ul>
              </>
            )
          }
          {
            qualifications.length > 0 && (
              <>
                <h3 class="text-lg font-semibold text-primary mt-8 mb-4">Qualifications</h3>
                <ul class="list-disc pl-5 space-y-3">
                  {qualifications.map((item: string) => <li>{item}</li>)}
                </ul>
              </>
            )
          }
        </div>
      </section>
      <aside class="w-full lg:w-80 shrink-0 border-t lg:border-t-0 lg:border-l border-outline-variant pt-8 lg:pt-0 lg:pl-8 space-y-8">
        <div>
          <p class="text-on-surface-variant">{employmentType}</p>
        </div>
        <div>
          <h4 class="text-base font-semibold text-primary mb-2">Work Experience</h4>
          <p class="text-on-surface-variant">{experience}</p>
        </div>
        <div>
          <h4 class="text-base font-semibold text-primary mb-2">Location</h4>
          <p class="text-on-surface-variant">{location}</p>
        </div>
      </aside>
    </div>
  </main>
  <Footer />
</BaseLayout>
