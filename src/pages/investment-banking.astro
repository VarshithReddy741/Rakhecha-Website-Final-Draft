<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">01</span><div><p class="font-label-bold text-primary">Identification of unlisted/pre-IPO opportunities</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">02</span><div><p class="font-label-bold text-primary">Structuring entry</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">03</span><div><p class="font-label-bold text-primary">FEMA and RBI compliance</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">04</span><div><p class="font-label-bold text-primary">Exit strategy advisory (block deals, IPO-linked exits)</p></div></div>
<div class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">05</span><div><p class="font-label-bold text-primary">Currency risk/hedging</p></div></div>
</div>
</div>
<div class="fund-anim fund-anim-4 mt-8 pt-6 border-t border-primary-light/15">
<h4 class="font-label-bold text-base font-bold text-primary-light mb-6 uppercase tracking-wider">Target FPI profile</h4>
<ul class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
<li class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">01</span><p class="font-body-sm text-on-surface-variant">Offshore funds with India mandates</p></li>
<li class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">02</span><p class="font-body-sm text-on-surface-variant">Family offices (Singapore, Mauritius, UAE, Cayman)</p></li>
<li class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">03</span><p class="font-body-sm text-on-surface-variant">Sovereign wealth funds/endowments</p></li>
<li class="fund-point flex items-center gap-4 rounded-lg -mx-3 px-3 py-2"><span class="hidden md:block text-3xl font-bold text-on-surface-variant leading-none flex-shrink-0">04</span><p class="font-body-sm text-on-surface-variant">Global PE/VC funds</p></li>
</ul>
</div>
`,
  credit: `
<h2 class="fund-anim fund-anim-1 font-headline-lg text-4xl md:text-5xl font-bold text-primary mb-5">Credit Papers</h2>
<p class="fund-anim fund-anim-2 font-body-md text-on-surface-variant max-w-2xl leading-relaxed mb-6">Lender-ready credit papers for your financing needs.</p>
<div class="fund-anim fund-anim-3">
<h4 class="font-label-bold text-base font-bold text-primary-light mb-8 uppercase tracking-wider">Our Services</h4>
<div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-2">
