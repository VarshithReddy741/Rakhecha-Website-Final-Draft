---
// Ported from "About us.html". Founder cards and Mission/Vision use the
// FounderCard/MissionVision components; the "Want to Know More?" banner
// uses CtaBanner (Prompt 2). Carousel/reveal behaviors come from
// /scripts/site-effects.js.
import { sanityClient, queries, type Founder } from "../lib/sanity";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FounderCard from "../components/FounderCard.astro";
import MissionVision from "../components/MissionVision.astro";
import CtaBanner from "../components/CtaBanner.astro";
import ourJourneyImage from "../assets/images/Our Journey.jpeg";
import devPhoto from "../assets/images/Dev.png";
import nitishPhoto from "../assets/images/Nitish.png";
import nidhhiPhoto from "../assets/images/Nidhhi.png";

const founderOrder = ["dev-piyush-rakhecha", "nidhhi-rakhecha", "nitish-rakhecha", "megha-rakhecha"];
const founderEntries = await sanityClient.fetch<Founder[]>(queries.allFounders);
const founders = founderOrder
  .map((slug) => founderEntries.find((f) => f.slug === slug))
  .filter((f): f is Founder => Boolean(f));

// Local, build-time-optimized photos for the founders whose photo actually
// lives in src/assets/ — Megha's is still a remote placeholder (see her
// founders/*.json entry) and falls back to the raw URL in FounderCard.
const founderPhotos: Record<string, ImageMetadata> = {
  "dev-piyush-rakhecha": devPhoto,
  "nitish-rakhecha": nitishPhoto,
  "nidhhi-rakhecha": nidhhiPhoto,
};
---

<BaseLayout
  title="About Us - Rakhecha Finserv"
  description="Learn about Rakhecha Finserv's story, leadership, and long-term approach to wealth management — founded by two brothers to deliver tailored, risk-adjusted outcomes for clients."
  bodyClass="bg-white text-on-surface font-body-md antialiased selection:bg-secondary-container selection:text-on-secondary-container"
>
  <Header />

  <main>
    <!-- Company Story -->
    <section class="py-14 bg-surface-yellow-light scroll-mt-24" id="our-story">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <h2 class="font-headline-lg text-headline-lg text-primary mb-6 text-center md:hidden">Our Story</h2>
        <div class="flex flex-col md:flex-row items-start gap-16">
          <div class="flex-1 w-full md:sticky md:top-28 aspect-[4/5] md:aspect-[3/4] relative rounded-2xl overflow-hidden shadow-xl">
            <Image src={ourJourneyImage} alt="Dev Piyush Rakhecha, Founder of Rakhecha Finserv" width={800} class="w-full h-full object-cover object-top" />
          </div>
          <div class="flex-1 space-y-6">
            <h2 class="hidden md:block font-headline-lg text-headline-lg text-primary mb-2">Our Story</h2>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">Rakhecha Finserv has been helping individuals and corporates manage and grow their wealth for nearly a decade. With over 100 Crore in Assets Under Management (AUM), we specialize in providing the best risk-adjusted returns for our clients.</p>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">Starting as a mutual fund distributor, we have diversified our offerings to include a wide range of asset classes, detailed in our list of services. As a long-term oriented wealth management firm, we prioritize financial success over short-term gains.</p>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">Founded by two brothers with MBA degrees, Rakhecha Finserv aspires to become one of India's leading wealth management firms. Their expertise allows them to thoroughly evaluate and recommend the best funds, ensuring an excellent client experience.</p>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">At Rakhecha Finserv, we provide tailored solutions because we understand that investments, like clothes, do not fit the same for everyone.</p>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">Client satisfaction is our priority, as we believe that exceptional client experiences are the key to our success and growth through referrals.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Strip -->
    <section class="bg-surface py-10 mt-8">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6 divide-y sm:divide-y-0 sm:divide-x divide-outline-variant">
          <div class="flex flex-col sm:flex-row items-center sm:justify-start gap-3 sm:gap-4 pt-8 sm:pt-0 first:pt-0 text-center sm:text-left">
            <div class="flex items-center justify-center w-14 h-14 rounded-full border-2 border-primary text-primary shrink-0"><span class="material-symbols-outlined text-2xl">apartment</span></div>
            <div class="text-center sm:text-left">
              <span class="block font-display-lg text-headline-md md:text-display-lg text-primary">₹<span class="count-up" data-target="200">200</span> Cr+</span>
              <span class="block font-label-bold text-label-bold uppercase tracking-widest text-on-surface-variant">Assets Under Management</span>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row items-center sm:justify-start gap-3 sm:gap-4 pt-8 sm:pt-0 sm:pl-6 text-center sm:text-left">
            <div class="flex items-center justify-center w-14 h-14 rounded-full border-2 border-primary text-primary shrink-0"><span class="material-symbols-outlined text-2xl">calendar_month</span></div>
            <div class="text-center sm:text-left">
              <span class="block font-display-lg text-headline-md md:text-display-lg text-primary"><span class="count-up" data-target="10">10</span>+</span>
              <span class="block font-label-bold text-label-bold uppercase tracking-widest text-on-surface-variant">Years in Business</span>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row items-center sm:justify-start gap-3 sm:gap-4 pt-8 sm:pt-0 sm:pl-6 text-center sm:text-left">
            <div class="flex items-center justify-center w-14 h-14 rounded-full border-2 border-primary text-primary shrink-0"><span class="material-symbols-outlined text-2xl">groups</span></div>
            <div class="text-center sm:text-left">
              <span class="block font-display-lg text-headline-md md:text-display-lg text-primary"><span class="count-up" data-target="300">300</span>+</span>
              <span class="block font-label-bold text-label-bold uppercase tracking-widest text-on-surface-variant">Clients Served Globally across Family Offices, UHNIs, NRIs</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission & Vision -->
    <section class="py-14 bg-surface-yellow-light">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop space-y-32">
        <MissionVision />
      </div>
    </section>

    <!-- Core Values -->
    <section id="core-values-section" class="py-14 bg-surface relative overflow-hidden scroll-mt-24">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
        <div class="text-center mb-16">
          <h3 class="font-headline-lg text-headline-lg text-primary mb-4">The Pillars of Our Practice</h3>
        </div>
        <div class="flex flex-col gap-5 md:grid md:grid-cols-[1fr_auto_1fr] md:grid-rows-[auto_auto] md:gap-x-14 md:gap-y-14 md:items-center">
          <div class="values-badge hidden md:flex shrink-0 relative w-48 h-48 md:w-56 md:h-56 md:col-start-2 md:row-start-1 md:row-span-2 md:justify-self-center items-center justify-center">
            <svg class="absolute inset-0 w-full h-full -rotate-90 z-0" viewBox="0 0 100 100">
              <circle cx="50" cy="50" fill="none" r="47" stroke="#123B5D" stroke-opacity="0.15" stroke-width="3"></circle>
              <circle id="values-ring-progress" cx="50" cy="50" fill="none" r="47" stroke="#123B5D" stroke-dasharray="295.31" stroke-dashoffset="295.31" stroke-linecap="round" stroke-width="3" style="transition: stroke-dashoffset 1.2s ease-in-out;"></circle>
            </svg>
            <div class="absolute inset-[7px] z-10 rounded-full bg-surface-yellow-light border-2 border-primary/15 flex items-center justify-center text-center shadow-xl overflow-hidden p-6">
              <img alt="Rakhecha Finserv" class="relative z-10 w-full h-full object-contain" src="/favicon.png" />
            </div>
          </div>
          <div class="value-row flex items-center md:block md:relative md:col-start-1 md:row-start-1">
            <div class="value-icon relative shrink-0 z-10 w-16 h-16 md:w-14 md:h-14 rounded-full bg-surface-container-lowest border border-outline-variant/40 shadow-md flex items-center justify-center transition-all duration-300 md:absolute md:-top-6 md:left-6">
              <span class="material-symbols-outlined text-primary text-2xl md:text-2xl">shield_locked</span>
            </div>
            <div class="value-pill flex-1 -ml-8 pl-12 pr-6 py-4 rounded-full bg-surface-container-lowest border border-outline-variant/30 shadow-sm hover:shadow-md hover:border-primary-light transition-all duration-300 md:ml-0 md:pl-8 md:pr-8 md:pt-10 md:pb-6 md:rounded-2xl">
              <h4 class="font-label-bold text-label-bold text-primary uppercase tracking-wide mb-1">Trust</h4>
              <p class="font-body-sm text-body-sm text-on-surface-variant leading-snug">The foundation of every relationship, earned daily through unwavering reliability.</p>
