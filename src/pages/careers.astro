---
// Ported from "careers.html". The three job cards now link to their own
// /careers/[slug]/ page (pulled from the jobs collection) instead of the
// single shared "Job detail.html" every card pointed to.
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import careersHeroImage from "../assets/images/Careers.jpg";

const jobs = await getCollection("jobs");

// Used as a CSS background-image, not an <img>/<Image> — pre-optimized
// through Astro's image pipeline here so the page still gets a hashed,
// resized WebP instead of the raw PNG.
const careersHeroOptimized = await getImage({ src: careersHeroImage, width: 1920, format: "webp" });
---

<BaseLayout
  title="Careers - Rakhecha Finserv"
  description="Explore current job openings at Rakhecha Finserv and apply to join our wealth management and investment banking team, or share your resume for future roles."
  bodyClass="bg-white text-on-surface font-body-md antialiased flex flex-col min-h-screen"
>
  <Header />

  <main class="flex-grow w-full">
    <!-- Hero Section -->
    <section class="relative bg-primary pt-32 pb-48 px-margin-mobile md:px-margin-desktop overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url("${careersHeroOptimized.src}");`}></div>
      <div class="max-w-container-max mx-auto relative z-10 flex flex-col md:flex-row items-center gap-12">
        <div class="max-w-2xl flex-1">
          <h1 class="font-display-lg text-display-lg text-primary mb-8 leading-tight">Careers at<br />Rakhecha Finserv</h1>
        </div>
      </div>
    </section>
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-20 space-y-section-gap pb-section-gap mt-12">
      <!-- Current Openings Section -->
      <section>
        <div class="bg-surface-container-lowest p-8 md:p-12 rounded-xl shadow-[0_8px_32px_rgba(0,36,82,0.08)] border border-surface-container-low mx-auto">
          <h2 class="font-display-lg text-display-lg text-primary text-center mb-12">Current Openings</h2>
          <div class="space-y-6 mb-12">
            <!-- Search Bar -->
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <span class="material-symbols-outlined text-on-surface-variant">search</span>
              </div>
              <input class="w-full pl-12 pr-4 py-4 bg-surface-container-lowest border border-outline-variant rounded-lg font-body-md text-on-surface focus:border-primary focus:outline-none transition-all shadow-sm" placeholder="Search jobs..." type="text" />
            </div>
            <!-- Dropdown Filters -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
              <div class="relative group">
                <div class="w-full px-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg flex justify-between items-center cursor-pointer hover:border-primary transition-all">
                  <span class="font-body-md text-on-surface-variant">Workplace type</span>
                  <span class="material-symbols-outlined text-on-surface-variant">expand_more</span>
                </div>
              </div>
              <div class="relative group">
                <div class="w-full px-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg flex justify-between items-center cursor-pointer hover:border-primary transition-all">
                  <span class="font-body-md text-on-surface-variant">Location</span>
                  <span class="material-symbols-outlined text-on-surface-variant">expand_more</span>
                </div>
              </div>
              <div class="relative group">
                <div class="w-full px-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg flex justify-between items-center cursor-pointer hover:border-primary transition-all">
                  <span class="font-body-md text-on-surface-variant">Department</span>
                  <span class="material-symbols-outlined text-on-surface-variant">expand_more</span>
                </div>
              </div>
              <div class="relative group">
                <div class="w-full px-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-lg flex justify-between items-center cursor-pointer hover:border-primary transition-all">
                  <span class="font-body-md text-on-surface-variant">Work type</span>
                  <span class="material-symbols-outlined text-on-surface-variant">expand_more</span>
                </div>
              </div>
            </div>
          </div>
          <div class="space-y-6">
            {
              jobs.map(({ data: job }) => (
                <div class="bg-surface-container-lowest rounded-lg border border-surface-variant p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 hover:shadow-md transition-all">
                  <div class="flex-grow">
                    <div class="flex items-center gap-3 mb-2">
                      <h3 class="font-headline-md text-headline-md text-primary">{job.title}</h3>
                      <span class="bg-surface-container text-primary px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider">Job ID: {job.jobId}</span>
                    </div>
                    <div class="flex flex-wrap gap-x-6 gap-y-2 text-on-surface-variant font-body-sm text-body-sm">
                      <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">location_on</span> {job.location}</span>
                      <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">work</span> {job.employmentType}</span>
                      <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">history</span> {job.experience}</span>
                    </div>
                  </div>
                  <a href={`/careers/${job.slug}/`} class="bg-primary text-white border border-secondary px-8 py-2 rounded font-cta-text text-cta-text hover:bg-primary-dark transition-colors duration-300 active:scale-95 inline-block text-center">View</a>
                </div>
              ))
            }
          </div>
        </div>
      </section>
      <!-- Share Your Resume Section -->
      <section class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-headline-lg text-headline-lg text-primary mb-4">Share Your Resume</h2>
          <p class="font-body-md text-body-md text-on-surface-variant">
            We are always looking to connect with talented individuals. Submit your details below, and we will keep your resume on file to review against future openings.
          </p>
        </div>
        <form class="space-y-8 bg-surface-container-lowest p-8 md:p-12 rounded-xl border border-surface-container-low shadow-[0_8px_32px_rgba(0,36,82,0.04)]">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <label class="block font-label-bold text-label-bold text-primary mb-2 uppercase tracking-wide" for="fullName">Full Name</label>
              <input class="w-full border-b border-outline-variant py-3 font-body-md text-body-md text-on-surface focus:border-primary focus:outline-none bg-transparent transition-all" id="fullName" placeholder="Enter your full name" type="text" />
            </div>
            <div>
              <label class="block font-label-bold text-label-bold text-primary mb-2 uppercase tracking-wide" for="email">Email Address</label>
              <input class="w-full border-b border-outline-variant py-3 font-body-md text-body-md text-on-surface focus:border-primary focus:outline-none bg-transparent transition-all" id="email" placeholder="Enter your email address" type="email" />
            </div>
          </div>
          <div>
            <label class="block font-label-bold text-label-bold text-primary mb-2 uppercase tracking-wide" for="interest">Area of Interest</label>
            <div class="relative">
              <input class="w-full border-b border-outline-variant py-3 font-body-md text-body-md text-on-surface focus:border-primary focus:outline-none bg-transparent transition-all" id="interest" placeholder="Enter your area of interest" type="text" />
            </div>
          </div>
          <div>
            <label class="block font-label-bold text-label-bold text-primary mb-4 uppercase tracking-wide" for="resume">Resume Upload</label>
            <div class="border-2 border-dashed border-outline-variant rounded-lg p-8 text-center hover:border-primary hover:bg-surface-container-low transition-colors cursor-pointer group flex flex-col items-center justify-center" id="resume-dropzone">
              <input class="hidden" id="resume" type="file" />
              <span class="material-symbols-outlined text-outline mb-3 group-hover:text-primary transition-colors text-4xl" style='font-variation-settings: "FILL" 0;'>upload_file</span>
              <p class="font-body-md text-body-md text-on-surface-variant group-hover:text-primary transition-colors">Click to upload or drag and drop</p>
              <p class="font-body-sm text-body-sm text-outline mt-1">PDF, DOCX up to 5MB</p>
            </div>
          </div>
          <div class="pt-6 flex justify-center">
            <button class="bg-primary text-white border border-secondary px-10 py-4 rounded font-cta-text text-cta-text hover:bg-primary-dark transition-colors duration-300 active:scale-95 w-full md:w-auto shadow-md hover:shadow-lg" type="button">Submit Application</button>
          </div>
        </form>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .input-focus-ring:focus {
    border-color: #123b5d;
    box-shadow: 0 0 0 2px rgba(229, 210, 154, 0.5); /* secondary-fixed-dim */
    outline: none;
  }
</style>

<script>
  const dropzone = document.getElementById("resume-dropzone");
  const resumeInput = document.getElementById("resume") as HTMLInputElement | null;
  if (dropzone && resumeInput) {
    dropzone.addEventListener("click", () => resumeInput.click());
    resumeInput.addEventListener("change", (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        const fileName = target.files[0].name;
        const paragraphs = dropzone.querySelectorAll("p");
        if (paragraphs[0]) paragraphs[0].innerHTML = `<span class="text-primary font-semibold">${fileName}</span>`;
        if (paragraphs[1]) paragraphs[1].textContent = "Selected for upload";
      }
    });
  }
</script>
