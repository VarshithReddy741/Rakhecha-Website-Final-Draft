---
// Ported from "Home Page.html". Founder cards and Mission/Vision now use
// the FounderCard/MissionVision components (Prompt 2) backed by the real
// founders collection (Prompt 3) instead of main.js's client-rendered
// innerHTML. Carousel/reveal behaviors (auto-scroll-x, founder-scroll-btn,
// hero-card-anim) come from /scripts/site-effects.js (see Prompt 4 notes).
import { sanityClient, queries, type Founder, type UpcomingEvent, type BusinessCard } from "../lib/sanity";
import { urlFor, resolveImage } from "../lib/sanityImage";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FounderCard from "../components/FounderCard.astro";
import MissionVision from "../components/MissionVision.astro";
import EventRegistrationModal from "../components/EventRegistrationModal.astro";
import heroDesktop from "../assets/images/Homepage image web.png";
import heroMobile from "../assets/images/Home page moblie.png";
import nriHero from "../assets/images/NRI services web.png";
import devPhoto from "../assets/images/Dev.png";
import nitishPhoto from "../assets/images/Nitish.png";
import nidhhiPhoto from "../assets/images/Nidhhi.png";

const founderOrder = ["dev-piyush-rakhecha", "nidhhi-rakhecha", "nitish-rakhecha", "megha-rakhecha"];
const [founderEntries, allUpcomingEvents, businessCards] = await Promise.all([
  sanityClient.fetch<Founder[]>(queries.allFounders),
  sanityClient.fetch<UpcomingEvent[]>(queries.upcomingEvents),
  sanityClient.fetch<BusinessCard[]>(queries.businessCards),
]);
const founders = founderOrder
  .map((slug) => founderEntries.find((f) => f.slug === slug))
  .filter((f): f is Founder => Boolean(f));
const homeUpcomingEvents = allUpcomingEvents.slice(0, 2);

function formatEventDate(dateStr?: string) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" });
}

// Local, build-time-optimized photos for the founders whose photo actually
// lives in src/assets/ — Megha's is still a remote placeholder (see her
// founders/*.json entry) and falls back to the raw URL in FounderCard.
const founderPhotos: Record<string, ImageMetadata> = {
  "dev-piyush-rakhecha": devPhoto,
  "nitish-rakhecha": nitishPhoto,
  "nidhhi-rakhecha": nidhhiPhoto,
};
