---
// Horizontal expanding-accordion gallery (desktop only) — an editorial,
// hover-to-reveal alternative view of the same service cards rendered by
// ServicePanel below it. Deliberately static/plain-props (no Sanity import
// here): callers just pass the same {id, title, desc, image} items they
// already fetched, so this component has zero content of its own to keep
// in sync.
export interface GalleryItem {
  id: string;
  title: string;
  desc: string;
  image: string;
}

export interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const galleryId = `sag-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="hidden md:flex service-accordion-gallery" data-gallery={galleryId}>
  {
    items.map((item) => (
      <a
        href={`#service-${item.id}`}
        class="service-accordion-card"
        data-panel={item.id}
        style={`background-image:url("${item.image}")`}
        aria-label={item.title}
      >
        <span class="service-accordion-overlay" />
        <span class="service-accordion-content">
          <span class="service-accordion-title">{item.title}</span>
          <span class="service-accordion-desc">{item.desc}</span>
          <span class="service-accordion-cta">
            Learn more
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </span>
        </span>
      </a>
    ))
  }
</div>

<style>
  .service-accordion-gallery {
    width: 100%;
    height: 560px;
    gap: 3px;
  }

  .service-accordion-card {
    position: relative;
    display: block;
    flex: 1 1 0%;
    min-width: 0;
    overflow: hidden;
    border-radius: 3px;
    background-size: cover;
    background-position: center;
    transition: flex-grow 0.6s cubic-bezier(0.22, 0.68, 0, 1);
  }
  .service-accordion-card:hover,
  .service-accordion-card:focus-visible {
    flex-grow: 3.4;
  }

  .service-accordion-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 32, 0.4);
    transition: background 0.6s cubic-bezier(0.22, 0.68, 0, 1);
  }
  .service-accordion-card:hover .service-accordion-overlay {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.2) 55%, rgba(0, 0, 0, 0.05) 100%);
  }

  .service-accordion-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    color: #fff;
    pointer-events: none;
  }

  .service-accordion-title {
    display: block;
    font-family: var(--font-headline-lg);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 0.5rem;
  }

  .service-accordion-desc {
    display: block;
    font-family: var(--font-body-sm);
    font-size: 14px;
    line-height: 1.5;
    max-width: 26rem;
    margin-bottom: 1rem;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .service-accordion-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-family: var(--font-cta-text);
    font-size: 14px;
    font-weight: 600;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.5s ease 0.05s,
      transform 0.5s ease 0.05s;
    pointer-events: auto;
  }

  .service-accordion-card:hover .service-accordion-desc,
  .service-accordion-card:hover .service-accordion-cta,
  .service-accordion-card:focus-visible .service-accordion-desc,
  .service-accordion-card:focus-visible .service-accordion-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .service-accordion-card:focus-visible .service-accordion-overlay {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.2) 55%, rgba(0, 0, 0, 0.05) 100%);
  }
</style>
