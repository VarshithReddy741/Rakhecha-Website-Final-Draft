import secondaryDealsImage from "../assets/images/secondary deals.jpeg";
import fpiHubImage from "../assets/images/FPI hub.jpeg";
import creditPaperImage from "../assets/images/Credit paper.jpeg";

// ServicePanel uses `image` both as a CSS background-image (desktop cards)
// and as a plain <img src> (mobile accordion) — see ServicePanel.astro — so
// there's no single <img>/<Image> call site to swap there. Instead we
// pre-optimize through Astro's image pipeline here and hand ServicePanel an
// already-hashed, already-WebP URL string, same as it always received.
const [fundraisingOptimized, ipoOptimized, valuationOptimized, maOptimized, secondaryOptimized, fpiOptimized, creditOptimized] =
  await Promise.all(
    [fundraisingImage, ipoImage, valuationImage, maImage, secondaryDealsImage, fpiHubImage, creditPaperImage].map((src) =>
      getImage({ src, width: 800, format: "webp" }),
    ),
  );

