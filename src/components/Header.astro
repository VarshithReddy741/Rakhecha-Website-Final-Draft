---
import { sanityClient, queries, type Service } from "../lib/sanity";

// Keep the header navigation in sync with the cards on each business-line
// page. Adding a service in Sanity therefore adds it to this menu as well.
const serviceLines = [
  { label: "Investment Banking", href: "/investment-banking", businessLine: "investment-banking" },
  { label: "Wealth Management", href: "/wealth-management", businessLine: "wealth-management" },
  { label: "Insurance", href: "/insurance", businessLine: "insurance" },
] as const;

const serviceGroups = await Promise.all(
  serviceLines.map(async (line) => ({
    ...line,
    services: await sanityClient.fetch<Service[]>(queries.servicesByLine, { businessLine: line.businessLine }),
  })),
);
---

<header
  class="site-header sticky top-0 w-full py-4 z-50 bg-surface-container-lowest dark:bg-surface-dim shadow-sm dark:shadow-none"
>
  <div class="site-header-row px-margin-mobile">
    <button
      class="min-[1300px]:hidden text-primary order-2"
      id="mobile-nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
    >
      <span class="material-symbols-outlined text-3xl" id="mobile-nav-icon">menu</span>
    </button>

    <div class="site-header-logo reveal-sm flex-shrink-0 w-64 order-1 min-[1300px]:order-none">
      <a href="/">
        <img
          alt="Rakhecha Finserv"
          class="block w-full h-auto"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuDjCB1d4MUkOZYdq6TnWLDlbaNlkJiznVdFxQUyJLGJQXqp7wuFpGTYRMQtOWkM-S58Nspjm8zDG5sQT51xnt8QlxkiskJfT11JyPO4fR0yB-rJpf9ihbTOJetIoG2gMBYeQSkqdgAk7TeX9DJwjjZLLSh0ChOwH8hLCHjoDaXtK5RLuCNQ4mGhN6Tka3_VJxQpzKfkW6wHM_F18BSDRyVMurwxEiuDaLrUXxuVh-FFCvx18bqU_SziUpmDZ2uWszAU0ZA"
        />
      </a>
    </div>

    <nav class="site-header-nav reveal-stagger hidden min-[1300px]:flex">
      <a class="reveal-sm nav-underline nav-item text-on-surface-variant dark:text-outline-variant hover:text-primary-light transition-colors duration-300 cursor-pointer font-bold" href="/about-us">About Us</a>
      {
        serviceGroups.map((group) => (
          <div class="reveal-sm nav-item relative group">
            <a
              class="nav-underline nav-trigger flex items-center text-on-surface-variant dark:text-outline-variant hover:text-primary-light focus:text-primary-light transition-colors duration-300 cursor-pointer font-bold"
              href={group.href}
              aria-haspopup="true"
            >
              <span>{group.label}</span>
              <span class="material-symbols-outlined text-base align-middle ml-0.5 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" aria-hidden="true">expand_more</span>
            </a>
            <div class="invisible absolute left-1/2 top-full z-50 w-72 -translate-x-1/2 pt-3 -translate-y-1 opacity-0 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0" style="transform-origin: top center;">
              <div class="overflow-hidden rounded-lg border border-outline-variant/30 bg-surface-container-lowest py-2 shadow-xl dark:bg-surface-dim">
                <a class="block px-4 py-2.5 text-sm font-semibold text-primary hover:bg-surface-container-low transition-colors" href={group.href}>
                  Explore {group.label}
                </a>
                <div class="my-1 border-t border-outline-variant/30"></div>
                {
                  group.services.map((service) => (
                    <a
                      class="block px-4 py-2 text-body-sm text-on-surface-variant hover:bg-surface-container-low hover:text-primary transition-colors"
                      href={`${group.href}#service-${service.cardId}`}
                    >
                      {service.title}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        ))
      }
      <a class="reveal-sm nav-underline nav-item text-on-surface-variant dark:text-outline-variant hover:text-primary-light transition-colors duration-300 cursor-pointer font-bold" href="/knowledge-hub">Knowledge Hub</a>
      <a class="reveal-sm nav-underline nav-item text-on-surface-variant dark:text-outline-variant hover:text-primary-light transition-colors duration-300 cursor-pointer font-bold" href="/careers">Careers</a>
    </nav>

    <div class="site-header-actions reveal-sm hidden min-[1300px]:flex" style="transition-delay: 0.2s">
      <a href="https://rakhechafinserv.investwell.app/app/#/login" target="_blank" rel="noopener noreferrer" class="action-btn bg-white border border-secondary text-primary font-cta-text rounded hover:bg-surface-container-low transition-colors inline-block text-center">Client Login</a>
      <a href="/contact-us" class="action-btn bg-primary text-white border border-secondary font-cta-text rounded shadow-sm hover:bg-primary-dark transition-colors inline-block text-center">Contact Us</a>
    </div>
  </div>

  <!-- Mobile Nav Panel -->
  <div
    class="hidden min-[1300px]:hidden absolute top-full left-0 w-full max-h-[80vh] overflow-y-auto bg-surface-container-lowest dark:bg-surface-dim shadow-lg z-40"
    id="mobile-nav-panel"
  >
    <div class="flex flex-col divide-y divide-outline-variant px-margin-mobile">
      <a class="py-5 text-headline-md font-headline-md text-primary block" href="/about-us">About Us</a>
      {
        serviceGroups.map((group) => (
          <div>
            <button
              class="w-full flex justify-between items-center py-5 text-left"
              id={`mobile-section-toggle-${group.businessLine}`}
              data-mobile-service-toggle
              data-mobile-section={group.businessLine}
              type="button"
              aria-expanded="false"
              aria-controls={`mobile-section-${group.businessLine}`}
            >
              <span class="text-headline-md font-headline-md text-primary">{group.label}</span>
              <span class="material-symbols-outlined text-primary transition-transform duration-300" id={`mobile-arrow-${group.businessLine}`}>expand_more</span>
            </button>
            <div class="hidden pb-4 space-y-3" id={`mobile-section-${group.businessLine}`}>
              <a class="block text-on-surface-variant hover:text-primary py-1 text-body-md font-body-md" href={group.href}>Explore {group.label}</a>
              {group.services.map((service) => (
                <a class="block text-on-surface-variant hover:text-primary py-1 text-body-md font-body-md" href={`${group.href}#service-${service.cardId}`}>{service.title}</a>
              ))}
            </div>
          </div>
        ))
      }
      <a class="py-5 text-headline-md font-headline-md text-primary block" href="/knowledge-hub">Knowledge Hub</a>
      <a class="py-5 text-headline-md font-headline-md text-primary block" href="/careers">Careers</a>
    </div>
    <div class="px-margin-mobile py-6 flex flex-col gap-3 border-t border-outline-variant">
      <a href="https://rakhechafinserv.investwell.app/app/#/login" target="_blank" rel="noopener noreferrer" class="bg-white border border-secondary text-primary font-cta-text px-6 py-3 rounded hover:bg-surface-container-low transition-colors inline-block text-center">Client Login</a>
      <a href="/contact-us" class="bg-primary text-white border border-secondary font-cta-text px-6 py-3 rounded shadow-sm hover:bg-primary-dark transition-colors inline-block text-center">Contact Us</a>
    </div>
  </div>
</header>

<style>
  /* Responsive header layout: a three-zone row (logo / nav / actions) that
     compresses fluidly with clamp() as the desktop viewport narrows, rather
     than snapping between a handful of fixed breakpoints. Below 1300px —
     the width this exact nav (6 items, including "Investment Banking" and
     "Wealth Management") actually needs to stay on one nowrap line even at
     its most compressed, with the logo at its full ~90%-of-header-height
     size — it collapses to the mobile hamburger layout instead (unchanged,
     handled by the existing Tailwind `hidden`/`min-[1300px]:` utilities in
     the markup). That number came from measuring real rendered nav-item
     widths at the floor clamp values below, not from a round-number guess.

     Every one of logo height, header padding, nav gap, nav font-size and
     button padding is one clamp() spanning the same two anchor widths
     (1300px -> the floor value, 1920px -> the ceiling value), so they all
     compress together in lockstep as the window narrows toward the mobile
     breakpoint — a "compact desktop" band that shows up naturally in the
     lower part of this range, without a second hand-tuned tier. (An
     earlier version used two separate tiers with their own clamp ranges;
     they didn't land on the same value at the tier boundary, so the row
     would briefly overflow again right above the tier switch. One
     continuous curve can't have that seam.)
  */
  .site-header {
    --header-h: clamp(58px, 4.84vw - 4.9px, 88px);
    --header-pad-x: clamp(1rem, 5.16vw - 51.1px, 3rem);
    --nav-gap: clamp(0.5rem, 3.23vw - 33.9px, 1.75rem);
    --nav-font: clamp(15px, 0.484vw + 8.71px, 18px);
    --btn-pad-x: clamp(0.6rem, 1.68vw - 12.2px, 1.25rem);
    --btn-gap: clamp(0.3rem, 1.16vw - 10.3px, 0.75rem);
    --col-gap: clamp(0.5rem, 3.87vw - 42.3px, 2rem);
  }

  .site-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media (min-width: 1300px) {
    /* --header-h becomes the header's total height at this breakpoint —
       the vertical py-4 padding is dropped in favor of the row owning the
       full height directly, so "90% of the header's height" (below) has
       one unambiguous height to be 90% of, rather than being diluted by
       padding the logo calc can't see. */
    .site-header {
      padding-top: 0;
      padding-bottom: 0;
    }
    .site-header-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--col-gap);
      padding-left: var(--header-pad-x);
      padding-right: var(--header-pad-x);
      height: var(--header-h);
    }

    /* Sized off the header's own height (not a width clamp), so the mark
       reads as prominent — 90% of the header's height — rather than
       shrinking away first as the row compresses. Width follows the logo's
       own aspect ratio. */
    .site-header-logo {
      display: flex;
      align-items: center;
      width: auto;
    }
    /* Sized directly off --header-h via calc(), not a percentage height —
       percentage heights need a definite (non-auto) height at every
       ancestor, and this grid's implicit row track is auto-sized, so a
       height:100%/90% chain here resolves against nothing and is ignored. */
    .site-header-logo img {
      display: block;
      width: auto;
      height: calc(var(--header-h) * 0.9);
    }

    .site-header-nav {
      justify-content: center;
      align-items: center;
      gap: var(--nav-gap);
      min-width: 0;
    }
    /* Every nav item — including the dropdown trigger + its chevron, which
       are one flex item together — stays a single nowrap unit. The nav
       never wraps; it only compresses via --nav-gap/--nav-font above. */
    .site-header-nav > .nav-item {
      flex: 0 0 auto;
      white-space: nowrap;
    }
    .site-header-nav .nav-item,
    .site-header-nav .nav-trigger {
      font-size: var(--nav-font);
    }

    .site-header-actions {
      justify-content: flex-end;
      align-items: center;
      gap: var(--btn-gap);
      flex-shrink: 0;
    }
    .site-header-actions .action-btn {
      white-space: nowrap;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
      padding-left: var(--btn-pad-x);
      padding-right: var(--btn-pad-x);
    }
  }
</style>

<script>
  // Mobile nav toggle + accordion sections, ported from main.js's
  // toggleMobileNav()/toggleMobileSection() (previously global functions
  // invoked via inline onclick=""). Only one Header exists per page, so
  // plain ids are safe here — same assumption the original markup made.
  function initHeader() {
    const navToggle = document.getElementById("mobile-nav-toggle");
    const panel = document.getElementById("mobile-nav-panel");
    const icon = document.getElementById("mobile-nav-icon");
    if (!navToggle || !panel || !icon) return;

    navToggle.addEventListener("click", () => {
      const opening = panel.classList.contains("hidden");
      panel.classList.toggle("hidden");
      icon.textContent = opening ? "close" : "menu";
      navToggle.setAttribute("aria-expanded", String(opening));
    });

    let activeSection: string | null = null;
    const serviceSectionToggles = Array.from(document.querySelectorAll<HTMLElement>("[data-mobile-service-toggle]"));

    function toggleSection(key: string) {
      const section = document.getElementById("mobile-section-" + key);
      const arrow = document.getElementById("mobile-arrow-" + key);
      const trigger = document.getElementById("mobile-section-toggle-" + key);
      if (!section || !arrow || !trigger) return;

      if (activeSection === key) {
        section.classList.add("hidden");
        arrow.style.transform = "rotate(0deg)";
        trigger.setAttribute("aria-expanded", "false");
        activeSection = null;
        return;
      }

      if (activeSection) {
        document.getElementById("mobile-section-" + activeSection)?.classList.add("hidden");
        document.getElementById("mobile-arrow-" + activeSection)?.style.setProperty("transform", "rotate(0deg)");
        document.getElementById("mobile-section-toggle-" + activeSection)?.setAttribute("aria-expanded", "false");
      }

      section.classList.remove("hidden");
      arrow.style.transform = "rotate(180deg)";
      trigger.setAttribute("aria-expanded", "true");
      activeSection = key;
    }

    serviceSectionToggles.forEach((toggle) => {
      const key = toggle.dataset.mobileSection;
      if (key) toggle.addEventListener("click", () => toggleSection(key));
    });

    // Close the mobile nav panel whenever a link inside it is tapped —
    // same-page anchor links don't trigger a full navigation, so without
    // this the panel would stay open on top of the page after it scrolls.
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) {
        panel.classList.add("hidden");
        icon.textContent = "menu";
        navToggle.setAttribute("aria-expanded", "false");
      }
    });
  }

  initHeader();
</script>
