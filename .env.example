DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"
S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET_NAME="rakhecha"
S3_REGION="auto"
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@rakhechafinserv.com"
EMAIL_INTERNAL_TEAM="team@rakhechafinserv.com"
EMAIL_INTERNAL_TA="team@rakhechafinserv.com"
EMAIL_EXPORT_RECIPIENTS="admin@rakhechafinserv.com"
IP_HASH_SALT="generate-a-random-32-char-string-here"

# Sanity — public identifiers, safe to expose; fall back to hardcoded
# defaults in src/lib/sanity.ts if unset, so these are only needed to
# point the site at a different project/dataset (e.g. staging).
PUBLIC_SANITY_PROJECT_ID="yoc5jesn"
PUBLIC_SANITY_DATASET="production"
# EDITOR-level token, only needed to run scripts/migrate-to-sanity.ts
SANITY_MIGRATION_TOKEN="sk..."
