---
// Styled to match the layout of "Founder Detail Page.html" in the repo
// root (hero with overlapping portrait + prose bio section). That source
// page hardcoded Dev Piyush Rakhecha's content and an "Areas of Expertise"
// grid that isn't part of the founders collection schema — the grid is
// intentionally left out here since inventing per-founder expertise tags
// wasn't part of this task; the hero/bio layout is what's ported.
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { truncateDescription } from "../../lib/seo";
import devPhoto from "../../assets/images/Dev.png";
import nitishPhoto from "../../assets/images/Nitish.png";
import nidhhiPhoto from "../../assets/images/Nidhhi.png";

// Local, build-time-optimized photos for the founders whose photo actually
// lives in src/assets/ — Megha's is still a remote placeholder (see her
// founders/*.json entry) and falls back to a plain <img> below.
const founderPhotos: Record<string, ImageMetadata> = {
  "dev-piyush-rakhecha": devPhoto,
  "nitish-rakhecha": nitishPhoto,
  "nidhhi-rakhecha": nidhhiPhoto,
};

export async function getStaticPaths() {
  const founders = await getCollection("founders");
  return founders.map((founder) => ({
    params: { slug: founder.data.slug },
    props: { founder },
  }));
}

const { founder } = Astro.props;
const { name, role, photo, education, shortBio, extendedBio, linkedinUrl } = founder.data;
const extendedParagraphs = extendedBio.split(/\n\n+/);

// Three of the four founders were ported with a placeholder
// "TODO: short bio pending" (see founders/*.json source comments) — use the
// real bio only when one actually exists.
const metaDescription = shortBio.startsWith("TODO:")
  ? `Meet ${name}, ${role} at Rakhecha Finserv.`
  : truncateDescription(shortBio);

const localPhoto = founderPhotos[founder.data.slug];
---

<BaseLayout
  title={`${name} - Leadership | Rakhecha Finserv`}
  description={metaDescription}
  bodyClass="bg-surface font-body-md text-on-surface antialiased selection:bg-secondary-container selection:text-secondary-fixed"
>
  <Header />
  <main>
    <!-- Hero Section -->
    <section class="hero-pattern bg-primary relative w-full pt-16 pb-8 md:pb-48 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-primary to-primary-container opacity-90"></div>
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative z-10 flex flex-col md:flex-row items-end md:items-center gap-8 md:gap-16">
        <div class="hidden md:block w-48 h-48 md:w-80 md:h-80 lg:w-96 lg:h-96 shrink-0 relative mt-8 md:mt-0 md:-mb-64 z-20">
          {
            localPhoto ? (
              <Image src={localPhoto} alt={name} width={480} class="w-full h-full object-cover rounded-lg shadow-2xl ring-4 ring-surface/10" />
            ) : (
              <img class="w-full h-full object-cover rounded-lg shadow-2xl ring-4 ring-surface/10" alt={name} src={photo} />
            )
          }
        </div>
        <div class="text-on-primary flex-grow pb-8 md:pb-0">
          <div class="flex items-center gap-2 mb-6 font-body-sm text-body-sm uppercase tracking-widest text-secondary-fixed-dim/80">
            <a class="underline hover:text-secondary-fixed transition-colors" href="/about#our-leadership">Leadership</a>
            <span>//</span>
            <span class="text-secondary-fixed">{name}</span>
          </div>
          <h1 class="font-display-lg text-display-lg text-on-primary mb-4">{name}</h1>
          <div class="font-body-lg text-body-lg text-on-primary/90 mb-6 max-w-2xl">{role}</div>
          {
            linkedinUrl && (
              <a
                class="inline-flex items-center gap-2 text-secondary-container hover:text-secondary-fixed transition-colors font-cta-text text-cta-text group border-b border-secondary-container/30 hover:border-secondary-fixed pb-1"
                href={linkedinUrl}
              >
                Connect on LinkedIn
                <span class="material-symbols-outlined text-[20px] group-hover:translate-x-1 transition-transform" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
              </a>
            )
          }
        </div>
      </div>
    </section>

    <!-- Mobile Portrait -->
    <div class="md:hidden max-w-container-max mx-auto px-margin-mobile pt-8">
      {
        localPhoto ? (
          <Image src={localPhoto} alt={name} width={800} class="w-full h-auto rounded-lg shadow-lg" />
        ) : (
          <img alt={name} class="w-full h-auto rounded-lg shadow-lg" src={photo} />
        )
      }
    </div>

    <!-- Biography Section -->
    <section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap">
      <div class="flex flex-col md:flex-row gap-gutter">
        <div class="hidden md:block md:w-80 lg:w-96 shrink-0"></div>
        <div class="flex-grow max-w-3xl prose prose-lg prose-slate prose-headings:font-headline-md prose-headings:text-primary prose-a:text-primary prose-a:font-semibold">
          <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed mb-8">{shortBio}</p>
          {
            extendedParagraphs.map((paragraph) => (
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-6">{paragraph}</p>
            ))
          }
          <div class="mt-12 pt-8 border-t border-outline-variant/30">
            <h3 class="font-headline-md text-headline-md text-primary mb-2">Education</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">{education}</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero-pattern {
    background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23123B5D' fill-opacity='0.1' fill-rule='evenodd'/%3E%3C/svg%3E");
  }
</style>
