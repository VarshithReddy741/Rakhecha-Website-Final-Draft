---
// Card data and expanded-panel content now come from Sanity (`service`
// documents with businessLine: "insurance"), editable/addable in Studio
// without a code change.
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ServicePanel from "../components/ServicePanel.astro";
import { sanityClient, queries, type Service } from "../lib/sanity";
import { urlFor } from "../lib/sanityImage";
import { renderPortableText } from "../lib/portableText";
import insuranceHeroDesktop from "../assets/images/Insurance hero card.png";
import insuranceHeroMobile from "../assets/images/Insurance mobile.png";

const insuranceServices = await sanityClient.fetch<Service[]>(queries.servicesByLine, { businessLine: "insurance" });

function renderServiceBody(svc: Service): string {
  const boxesHtml = (svc.contentBoxes ?? [])
    .map(
      (box) => `
${box.heading ? `<h4 class="font-label-bold text-base font-bold text-primary-light mb-6 uppercase tracking-wider">${box.heading}</h4>` : ""}
${renderPortableText(box.body)}`,
    )
    .join("<hr class=\"border-outline-variant/30 my-8\">");

  return `<h2 class="font-headline-lg text-4xl md:text-5xl font-bold text-primary mb-4">${svc.title}</h2>${boxesHtml}`;
}

const insuranceBodies: Record<string, string> = Object.fromEntries(insuranceServices.map((svc) => [svc.cardId, renderServiceBody(svc)]));

const insuranceItems = insuranceServices.map((svc) => ({
  id: svc.cardId,
  title: svc.title,
  desc: svc.shortDescription ?? "",
  image: urlFor(svc.image).width(800).url(),
  imagePosition: svc.imagePosition,
  bodyHtml: insuranceBodies[svc.cardId],
}));
---

<BaseLayout
  title="Insurance - Rakhecha Finserv"
  description="Comprehensive individual and business insurance solutions from Rakhecha Finserv, designed to protect your assets, manage risk, and provide long-term peace of mind."
  bodyClass="bg-white text-on-surface font-body-md antialiased min-h-screen flex flex-col"
>
  <Header />

  <main class="flex-grow flex flex-col">
    <!-- Hero Section -->
    <section class="relative h-screen min-h-[600px] flex items-start md:items-center justify-start overflow-hidden">
      <div class="absolute inset-0 z-0">
        <Picture
          src={insuranceHeroDesktop}
          alt="Insurance hero"
          class="hidden md:block w-full h-full object-cover"
          widths={[768, 1280, 1920]}
          sizes="100vw"
          formats={["webp"]}
          fallbackFormat="webp"
          loading="eager"
        />
        <Picture
          src={insuranceHeroMobile}
          alt="Wooden figures of a family sheltered under an umbrella"
          class="md:hidden w-full h-full object-cover object-bottom"
          widths={[480, 768]}
          sizes="100vw"
          formats={["webp"]}
          fallbackFormat="webp"
          loading="eager"
        />
      </div>
      <div class="relative z-10 w-full max-w-container-max px-margin-mobile md:px-margin-desktop pt-[18vh] md:pt-0">
        <h1 class="text-display-lg font-display-lg text-white mb-6 max-w-4xl">Comprehensive Protection and Risk Stewardship</h1>
      </div>
    </section>
    <!-- Services Interactive Section -->
    <section class="py-section-gap bg-white relative z-20 -mt-20">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
        <ServicePanel items={insuranceItems} columns={2} expandedHeight="h-[440px]" expandedScale={true} collapsedSpanFull={true} />
      </div>
    </section>
    <!-- Contact CTA -->
    <section class="py-14 md:py-20 px-margin-mobile md:px-margin-desktop">
      <div class="max-w-container-max mx-auto">
        <div class="bg-primary text-on-primary rounded-xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
          <div class="max-w-xl">
            <h2 class="font-headline-lg text-headline-lg mb-2">Ready to Protect What Matters Most?</h2>
            <p class="font-body-md text-body-md text-primary-fixed opacity-90">Speak with our advisory team to find the right coverage for your needs.</p>
          </div>
          <a href="/contact-us/" class="bg-secondary-fixed text-on-secondary-fixed font-cta-text text-cta-text px-6 py-3 rounded-lg hover:bg-secondary-fixed-dim transition-colors whitespace-nowrap inline-block text-center">Contact Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
