---
// Extracted from the "bg-primary rounded-xl ... Contact Us" CTA banner
// duplicated (with different copy) across About us.html, IB.html,
// "Wealth Management.html", and "Insurance Page.html".
//
// Note: none of the live pages actually use the literal copy
// "Book a Consultation" for this block — that phrase only appears as a
// section heading on "Contact us page.html"'s form, a different piece of
// markup. This component matches the CTA banner that's genuinely
// duplicated site-wide; buttonHref defaults to the pattern all four pages
// use ("Contact Us" linking to the contact page).
export interface Props {
  heading: string;
  description: string;
  buttonText: string;
  buttonHref?: string;
  icon?: string;
}

const { heading, description, buttonText, buttonHref, icon } = Astro.props;
---

<section class="py-14 md:py-20 px-margin-mobile md:px-margin-desktop">
  <div class="max-w-container-max mx-auto">
    <div class="bg-primary text-on-primary rounded-xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-xl">
        <h2 class="font-headline-lg text-headline-lg mb-2">{heading}</h2>
        <p class="font-body-md text-body-md text-primary-fixed opacity-90">{description}</p>
      </div>
      {
        buttonHref ? (
          <a
            href={buttonHref}
            class="bg-secondary-fixed text-on-secondary-fixed font-cta-text text-cta-text px-6 py-3 rounded-lg hover:bg-secondary-fixed-dim transition-colors whitespace-nowrap inline-flex items-center gap-2 text-center"
          >
            {icon && <span class="material-symbols-outlined">{icon}</span>}
            {buttonText}
          </a>
        ) : (
          <button
            type="button"
            class="bg-secondary-fixed text-on-secondary-fixed font-cta-text text-cta-text px-6 py-3 rounded-lg hover:bg-secondary-fixed-dim transition-colors whitespace-nowrap inline-flex items-center gap-2"
          >
            {icon && <span class="material-symbols-outlined">{icon}</span>}
            {buttonText}
          </button>
        )
      }
    </div>
  </div>
</section>
