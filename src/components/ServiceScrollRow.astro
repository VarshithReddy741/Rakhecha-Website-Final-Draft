---
// Plain horizontal-scrolling card row (desktop only) with prev/next arrow
// buttons — a simpler, non-accordion sibling to ServiceAccordionGallery.
// Same static-props shape (no Sanity import here): callers pass the same
// {id, title, desc, image} items they already fetched.
export interface ScrollRowItem {
  id: string;
  title: string;
  desc: string;
  image: string;
  /** Rendered HTML shown in the pop-out panel when a card is clicked. Falls back to `desc` when omitted. */
  bodyHtml?: string;
}

export interface Props {
  items: ScrollRowItem[];
}

const { items } = Astro.props;
const rowId = `ssr-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="hidden md:block service-scroll-wrap">
  <div class="service-scroll-controls" data-row-controls={rowId}>
    <button type="button" class="service-scroll-arrow" data-row-prev aria-label="Scroll left">
      <span class="material-symbols-outlined">chevron_left</span>
    </button>
    <button type="button" class="service-scroll-arrow" data-row-next aria-label="Scroll right">
      <span class="material-symbols-outlined">chevron_right</span>
    </button>
  </div>
  <div class="flex service-scroll-row hide-scrollbar" data-row={rowId}>
    {
      items.map((item) => (
        <a href={`#service-${item.id}`} class="service-scroll-card" data-scroll-card={item.id} aria-label={item.title} aria-expanded="false">
          <div class="service-scroll-image" style={`background-image:url("${item.image}")`} />
          <div class="service-scroll-overlay" />
          <div class="service-scroll-text">
            <h3 class="service-scroll-title">{item.title}</h3>
            <p class="service-scroll-desc">{item.desc}</p>
          </div>
        </a>
      ))
    }
  </div>

  <div class="service-scroll-detail" data-row-panel-root hidden>
    <button type="button" class="service-scroll-detail-close" data-row-panel-close aria-label="Close">
      <span class="material-symbols-outlined">close</span>
    </button>
    <div>
      {
        items.map((item) => (
          <div class="hidden" data-row-panel-body={item.id} set:html={item.bodyHtml ?? `<p class="font-body-md text-body-md text-on-surface-variant">${item.desc}</p>`} />
        ))
      }
    </div>
  </div>
</div>

<style>
  .service-scroll-wrap {
    position: relative;
  }

  .service-scroll-controls {
    position: absolute;
    top: -52px;
    right: 0;
    display: none;
    gap: 0.5rem;
    z-index: 5;
  }
  .service-scroll-controls.is-visible {
    display: flex;
  }

  .service-scroll-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--color-outline-variant, #d5dbe1);
    background: #fff;
    color: var(--color-primary, #123b5d);
    cursor: pointer;
    transition:
      background 0.2s ease,
      opacity 0.2s ease;
  }
  .service-scroll-arrow:hover {
    background: var(--color-surface-container-low, #f0f2f5);
  }
  .service-scroll-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .service-scroll-row {
    width: 100%;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 0.5rem;
  }

  .service-scroll-card {
    position: relative;
    display: block;
    flex: 0 0 300px;
    height: 420px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-outline-variant, #d5dbe1);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .service-scroll-card:hover,
  .service-scroll-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
  }
  .service-scroll-card.is-active {
    transform: translateY(-8px) scale(1.03);
    box-shadow: 0 28px 56px rgba(0, 0, 0, 0.3);
    z-index: 2;
  }

  .service-scroll-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s ease;
  }
  .service-scroll-card:hover .service-scroll-image,
  .service-scroll-card:focus-visible .service-scroll-image {
    transform: scale(1.06);
  }

  .service-scroll-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.15) 55%, rgba(0, 0, 0, 0.05) 100%);
  }

  .service-scroll-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    color: #fff;
  }

  .service-scroll-title {
    font-family: var(--font-headline-md);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .service-scroll-desc {
    font-family: var(--font-body-sm);
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }

  .service-scroll-detail {
    position: relative;
    margin-top: 2.5rem;
    padding: 2.5rem;
    border-radius: 12px;
    background: var(--color-surface-container-lowest, #f7f8fa);
    border: 1px solid var(--color-outline-variant, #d5dbe1);
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  .service-scroll-detail.is-open {
    opacity: 1;
    transform: translateY(0);
  }

  .service-scroll-detail-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: var(--color-on-surface-variant, #444);
    cursor: pointer;
  }
  .service-scroll-detail-close:hover {
    background: var(--color-surface-container-low, #eceff2);
  }
</style>

<script>
  function triggerFundAnim(root: Element) {
    const els = root.querySelectorAll(".fund-anim");
    if (!els.length) return;
    els.forEach((el) => el.classList.remove("in-view"));
    void (root as HTMLElement).offsetWidth;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        els.forEach((el) => el.classList.add("in-view"));
      });
    });
  }

  function initRow(row: HTMLElement) {
    const id = row.dataset.row;
    const controls = document.querySelector<HTMLElement>(`[data-row-controls="${id}"]`);
    const prevBtn = controls?.querySelector<HTMLButtonElement>("[data-row-prev]");
    const nextBtn = controls?.querySelector<HTMLButtonElement>("[data-row-next]");
    const wrap = row.closest<HTMLElement>(".service-scroll-wrap");
    const panelRoot = wrap?.querySelector<HTMLElement>("[data-row-panel-root]");
    const panelClose = wrap?.querySelector<HTMLElement>("[data-row-panel-close]");
    if (!controls || !prevBtn || !nextBtn || !wrap || !panelRoot || !panelClose) return;

    const cards = Array.from(row.querySelectorAll<HTMLElement>("[data-scroll-card]"));
    let activeId: string | null = null;

    function openPanel(cardId: string) {
      panelRoot!.querySelectorAll("[data-row-panel-body]").forEach((el) => {
        el.classList.toggle("hidden", el.getAttribute("data-row-panel-body") !== cardId);
      });
      panelRoot!.hidden = false;
      void panelRoot!.offsetWidth;
      panelRoot!.classList.add("is-open");
      const shown = panelRoot!.querySelector(`[data-row-panel-body="${cardId}"]`);
      if (shown) triggerFundAnim(shown);
    }

    function closePanel() {
      panelRoot!.classList.remove("is-open");
      window.setTimeout(() => {
        if (!activeId) panelRoot!.hidden = true;
      }, 500);
    }

    function setActive(card: HTMLElement | null) {
      activeId = card?.dataset.scrollCard ?? null;
      cards.forEach((c) => {
        c.classList.toggle("is-active", c === card);
        c.setAttribute("aria-expanded", String(c === card));
      });
      if (card && activeId) {
        card.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
        openPanel(activeId);
      } else {
        closePanel();
      }
    }

    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        e.preventDefault();
        setActive(activeId === card.dataset.scrollCard ? null : card);
      });
    });
    panelClose.addEventListener("click", () => setActive(null));

    function update() {
      const hasOverflow = row.scrollWidth > row.clientWidth + 1;
      controls!.classList.toggle("is-visible", hasOverflow);
      prevBtn!.disabled = row.scrollLeft <= 1;
      nextBtn!.disabled = row.scrollLeft >= row.scrollWidth - row.clientWidth - 1;
    }

    prevBtn.addEventListener("click", () => {
      row.scrollBy({ left: -row.clientWidth * 0.8, behavior: "smooth" });
    });
    nextBtn.addEventListener("click", () => {
      row.scrollBy({ left: row.clientWidth * 0.8, behavior: "smooth" });
    });

    row.addEventListener("scroll", update);
    window.addEventListener("resize", update);
    update();
  }

  document.querySelectorAll<HTMLElement>("[data-row]").forEach(initRow);
</script>
