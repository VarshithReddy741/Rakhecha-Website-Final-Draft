---
// Horizontal expanding-accordion gallery (desktop only) — an editorial,
// hover-to-reveal alternative view of the same service cards rendered by
// ServicePanel below it. Deliberately static/plain-props (no Sanity import
// here): callers just pass the same {id, title, desc, image} items they
// already fetched, so this component has zero content of its own to keep
// in sync.
export interface GalleryItem {
  id: string;
  title: string;
  desc: string;
  image: string;
}

export interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const galleryId = `sag-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="hidden md:block service-accordion-wrap">
  <div class="service-accordion-controls" data-gallery-controls={galleryId}>
    <button type="button" class="service-accordion-arrow" data-gallery-prev aria-label="Scroll left">
      <span class="material-symbols-outlined">chevron_left</span>
    </button>
    <button type="button" class="service-accordion-arrow" data-gallery-next aria-label="Scroll right">
      <span class="material-symbols-outlined">chevron_right</span>
    </button>
  </div>
  <div class="flex service-accordion-gallery hide-scrollbar" data-gallery={galleryId}>
    {
      items.map((item) => (
        <a
          href={`#service-${item.id}`}
          class="service-accordion-card"
          data-panel={item.id}
          style={`background-image:url("${item.image}")`}
          aria-label={item.title}
        >
          <span class="service-accordion-overlay" />
          <span class="service-accordion-content">
            <span class="service-accordion-title">
              {item.title.split(" ").map((word, i) => (i === 0 ? word : <>{" "}<br class="service-accordion-title-break" />{word}</>))}
            </span>
            <span class="service-accordion-desc">{item.desc}</span>
            <span class="service-accordion-cta">
              Learn more
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </span>
          </span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .service-accordion-wrap {
    position: relative;
  }

  .service-accordion-controls {
    position: absolute;
    top: -52px;
    right: 0;
    display: none;
    gap: 0.5rem;
    z-index: 5;
  }
  .service-accordion-controls.is-visible {
    display: flex;
  }

  .service-accordion-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--color-outline-variant, #d5dbe1);
    background: #fff;
    color: var(--color-primary, #123b5d);
    cursor: pointer;
    transition:
      background 0.2s ease,
      opacity 0.2s ease;
  }
  .service-accordion-arrow:hover {
    background: var(--color-surface-container-low, #f0f2f5);
  }
  .service-accordion-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .service-accordion-gallery {
    width: 100%;
    height: 560px;
    gap: 3px;
    overflow-x: auto;
    scroll-behavior: smooth;
  }

  .service-accordion-card {
    position: relative;
    display: block;
    flex: 1 1 0%;
    min-width: 210px;
    overflow: hidden;
    border-radius: 3px;
    background-size: cover;
    background-position: center;
    transition: flex-basis 0.6s cubic-bezier(0.22, 0.68, 0, 1);
  }

  .service-accordion-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 20, 32, 0.4);
    transition: background 0.6s cubic-bezier(0.22, 0.68, 0, 1);
  }
  .service-accordion-card:hover .service-accordion-overlay {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.2) 55%, rgba(0, 0, 0, 0.05) 100%);
  }

  .service-accordion-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    color: #fff;
    pointer-events: none;
  }

  .service-accordion-title {
    display: block;
    font-family: var(--font-headline-lg);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition: font-size 0.4s ease;
  }
  .service-accordion-title-break {
    display: block;
    content: "";
  }
  .service-accordion-card:hover .service-accordion-title,
  .service-accordion-card:focus-visible .service-accordion-title {
    font-size: 24px;
  }
  .service-accordion-card:hover .service-accordion-title-break,
  .service-accordion-card:focus-visible .service-accordion-title-break {
    display: none;
  }

  .service-accordion-desc {
    display: block;
    font-family: var(--font-body-sm);
    font-size: 14px;
    line-height: 1.5;
    max-width: 26rem;
    margin-bottom: 1rem;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .service-accordion-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-family: var(--font-cta-text);
    font-size: 14px;
    font-weight: 600;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.5s ease 0.05s,
      transform 0.5s ease 0.05s;
    pointer-events: auto;
  }

  .service-accordion-card:hover .service-accordion-desc,
  .service-accordion-card:hover .service-accordion-cta,
  .service-accordion-card:focus-visible .service-accordion-desc,
  .service-accordion-card:focus-visible .service-accordion-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .service-accordion-card:focus-visible .service-accordion-overlay {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.2) 55%, rgba(0, 0, 0, 0.05) 100%);
  }
</style>

<script>
  const EXPANDED_WIDTH = 640;
  const COLLAPSED_WIDTH = 210;

  function initGallery(gallery: HTMLElement) {
    const cards = Array.from(gallery.querySelectorAll<HTMLElement>("[data-panel]"));
    const id = gallery.dataset.gallery;
    const controls = document.querySelector<HTMLElement>(`[data-gallery-controls="${id}"]`);
    const prevBtn = controls?.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const nextBtn = controls?.querySelector<HTMLButtonElement>("[data-gallery-next]");
    if (!controls || !prevBtn || !nextBtn) return;

    // flex-grow alone can't expand a card once the row is already wider
    // than its container (no positive free space left to redistribute) —
    // which is exactly the overflowing state the arrows exist for. Setting
    // an explicit flex-basis per card works in both the fitting and
    // overflowing cases, at the cost of driving it from JS instead of pure
    // CSS :hover.
    function setActive(activeCard: HTMLElement | null) {
      cards.forEach((c) => {
        if (!activeCard) {
          c.style.flex = "";
          return;
        }
        // flex-grow/shrink must be pinned to 0 here: the row is already at
        // (or past) its min-width floor once it's overflowing, and without
        // this, flex-shrink would immediately squash the expanded card's
        // basis right back down to fit the container instead of letting
        // the row scroll wider.
        const width = c === activeCard ? EXPANDED_WIDTH : COLLAPSED_WIDTH;
        c.style.flex = `0 0 ${width}px`;
      });
    }

    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => setActive(card));
      card.addEventListener("focus", () => setActive(card));
    });
    gallery.addEventListener("mouseleave", () => setActive(null));
    gallery.addEventListener(
      "focusout",
      (e) => {
        if (!gallery.contains((e as FocusEvent).relatedTarget as Node)) setActive(null);
      },
    );

    function update() {
      const hasOverflow = gallery.scrollWidth > gallery.clientWidth + 1;
      controls!.classList.toggle("is-visible", hasOverflow);
      prevBtn!.disabled = gallery.scrollLeft <= 1;
      nextBtn!.disabled = gallery.scrollLeft >= gallery.scrollWidth - gallery.clientWidth - 1;
    }

    prevBtn.addEventListener("click", () => {
      gallery.scrollBy({ left: -gallery.clientWidth * 0.6, behavior: "smooth" });
    });
    nextBtn.addEventListener("click", () => {
      gallery.scrollBy({ left: gallery.clientWidth * 0.6, behavior: "smooth" });
    });

    gallery.addEventListener("scroll", update);
    window.addEventListener("resize", update);
    // Expanding a card on hover changes scrollWidth, so re-check then too.
    gallery.addEventListener("transitionend", update);
    update();
  }

  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach(initGallery);
</script>
