// Hand-authored heading + fund-anim classes wrap each Sanity content box so
// the existing staggered reveal (ServicePanel's triggerFundAnim) still
// applies.
function renderServiceBody(svc: Service): string {
  const boxesHtml = (svc.contentBoxes ?? [])
    .map(
      (box, i) => `
<div class="fund-anim fund-anim-${Math.min(i + 2, 4)}${box.heading ? " mt-8 pt-6 border-t border-primary-light/15" : ""}">
${box.heading ? `<h4 class="font-label-bold text-base font-bold text-primary-light mb-6 uppercase tracking-wider">${box.heading}</h4>` : ""}
${renderPortableText(box.body)}
</div>`,
    )
    .join("");

  let html = `<h2 class="fund-anim fund-anim-1 font-headline-lg text-4xl md:text-5xl font-bold text-primary mb-5">${svc.title}</h2>${boxesHtml}`;
  if (svc.cardId === "secondary") html += SECONDARY_DEALS_EXTRA;
  return html;
}

const ibBodies: Record<string, string> = Object.fromEntries(ibServices.map((svc) => [svc.cardId, renderServiceBody(svc)]));

const ibItems = ibServices.map((svc) => ({
  id: svc.cardId,
  title: svc.title,
  desc: svc.shortDescription ?? "",
  image: urlFor(svc.image).width(800).url(),
  bodyHtml: ibBodies[svc.cardId],
}));
---

<BaseLayout
  title="Investment Banking Hub - Rakhecha Finserv"
  description="Rakhecha Finserv's investment banking team advises on fundraising, IPO listings, valuation, M&A, secondary deals, FPI access, and credit papers to unlock your next stage of growth."
  bodyClass="bg-white text-on-surface font-body-md antialiased min-h-screen flex flex-col"
>
  <Header />

  <main class="flex-grow flex flex-col">
    <!-- Hero Section -->
    <section class="relative h-screen min-h-[600px] flex items-start md:items-center justify-start overflow-hidden">
      <div class="parallax absolute inset-0 z-0">
        <Picture
          src={ibHeroDesktop}
          alt="Distinctive glass skyscraper with an observation deck against a clear sky"
          class="hidden md:block w-full h-full object-cover"
          widths={[768, 1280, 1920]}
          sizes="100vw"
          formats={["webp"]}
          fallbackFormat="webp"
          loading="eager"
        />
        <Picture
          src={ibHeroMobile}
          alt="Rock climber scaling a sunlit cliff face"
          class="md:hidden w-full h-full object-cover object-bottom"
          widths={[480, 768]}
          sizes="100vw"
          formats={["webp"]}
          fallbackFormat="webp"
          loading="eager"
        />
      </div>
      <div class="relative z-10 w-full max-w-container-max px-margin-mobile md:px-margin-desktop pt-[24vh] md:pt-0">
        <h1 class="reveal mask-reveal text-display-lg font-display-lg text-primary mb-6 max-w-4xl"><span>Unlocking the Next Stage of Growth.</span></h1>
        <div class="flex gap-4"></div>
      </div>
    </section>
    <!-- Services Interactive Section -->
    <section class="py-section-gap bg-white relative z-20 -mt-20">
      <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop" data-service-ids={ibItems.map((item) => item.id).join(",")}>
        <h3 class="reveal md:hidden font-headline-lg text-headline-lg text-primary mb-4">Capabilities</h3>
        <div class="hidden md:flex items-center justify-between mb-6">
          <h3 class="reveal font-headline-lg text-headline-lg text-primary">Capabilities</h3>
          <div class="flex items-center gap-3">
            <select
              data-layout-select
              aria-label="Choose how capabilities are displayed"
              class="text-body-sm font-body-sm text-on-surface-variant border border-outline-variant rounded-md px-3 py-1.5 bg-white focus:outline-none focus:border-primary"
            >
              <option value="accordion">Expanding Panels</option>
              <option value="scroll">Scroll Gallery</option>
              <option value="grid">Grid View</option>
            </select>
            <select
              data-display-select
              aria-label="Choose whether a card opens in page or in a popup"
              class="text-body-sm font-body-sm text-on-surface-variant border border-outline-variant rounded-md px-3 py-1.5 bg-white focus:outline-none focus:border-primary"
            >
              <option value="page">Opens In Page</option>
              <option value="popup">Opens In Popup</option>
            </select>
          </div>
        </div>
        <div data-layout-panel="accordion">
          <ServiceAccordionGallery items={ibItems} />
        </div>
        <div data-layout-panel="scroll">
          <ServiceScrollRow items={ibItems} />
        </div>
        <div data-layout-panel="grid">
          <ServicePanel items={ibItems} columns={3} capabilitiesHeading="" />
        </div>
      </div>

      <!-- Popup mode: shared modal that any of the three layouts above opens
           into when "Opens In Popup" is selected, instead of their own
           in-page expansion (see the click-interceptor script below). Reuses
           whichever hidden per-card content node the active layout already
           rendered rather than duplicating bodyHtml a fourth time. -->
      <div class="service-modal-backdrop hidden" data-service-modal>
        <button type="button" class="service-modal-arrow service-modal-arrow-left" data-service-modal-prev aria-label="Previous service">
          <span class="material-symbols-outlined">chevron_left</span>
        </button>
        <div class="service-modal-panel" data-service-modal-panel>
          <button type="button" class="service-modal-close" data-service-modal-close aria-label="Close">
            <span class="material-symbols-outlined">close</span>
          </button>
          <div class="service-modal-content" data-service-modal-content></div>
        </div>
        <button type="button" class="service-modal-arrow service-modal-arrow-right" data-service-modal-next aria-label="Next service">
          <span class="material-symbols-outlined">chevron_right</span>
        </button>
      </div>
    </section>
    <!-- Contact CTA -->
    <section class="py-14 md:py-20 px-margin-mobile md:px-margin-desktop">
      <div class="max-w-container-max mx-auto">
        <div class="reveal bg-primary text-on-primary rounded-xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
          <div class="max-w-xl">
            <h2 class="font-headline-lg text-headline-lg mb-2">Ready to Navigate Global Capital Markets?</h2>
            <p class="font-body-md text-body-md text-primary-fixed opacity-90">Speak with our team to discuss how our investment banking expertise can serve your goals.</p>
          </div>
          <a href="/contact-us/" class="bg-secondary-fixed text-on-secondary-fixed font-cta-text text-cta-text px-6 py-3 rounded-lg hover:bg-secondary-fixed-dim transition-colors whitespace-nowrap inline-block text-center">Contact Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .service-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 5rem;
    background: rgba(10, 22, 34, 0.62);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .service-modal-backdrop.hidden {
    display: none;
  }
  .service-modal-backdrop.is-open {
    opacity: 1;
  }

  .service-modal-panel {
    position: relative;
    width: 100%;
    max-width: 800px;
    max-height: 85vh;
    overflow-y: auto;
    background: var(--color-surface-container-lowest, #f7f8fa);
    border: 1px solid var(--color-outline-variant, #d5dbe1);
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 32px 64px rgba(0, 0, 0, 0.35);
    transform: translateY(24px) scale(0.98);
    opacity: 0;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .service-modal-backdrop.is-open .service-modal-panel {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .service-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: var(--color-on-surface-variant, #444);
    cursor: pointer;
  }
  .service-modal-close:hover {
    background: var(--color-surface-container-low, #eceff2);
  }

  .service-modal-arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: none;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .service-modal-arrow:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 767px) {
    .service-modal-backdrop {
      padding: 1.5rem;
    }
    .service-modal-arrow {
      display: none;
    }
  }
</style>

<script>
  // Popup display mode (Investment Banking, desktop only): when the second
  // dropdown is set to "Opens In Popup", clicking a card in any of the three
  // layouts above opens this shared modal instead of that layout's own
  // in-page panel/accordion — arrow buttons cycle through every service,
  // the X and a backdrop click both close it. A capture-phase listener on
  // the document intercepts the click (and stops it) before each layout's
  // own bubble-phase click handler runs, so nothing in those three
  // components needs to know popup mode exists.
  (function () {
    const modal = document.querySelector<HTMLElement>("[data-service-modal]");
    const content = modal?.querySelector<HTMLElement>("[data-service-modal-content]");
    const closeBtn = modal?.querySelector<HTMLElement>("[data-service-modal-close]");
    const prevBtn = modal?.querySelector<HTMLButtonElement>("[data-service-modal-prev]");
    const nextBtn = modal?.querySelector<HTMLButtonElement>("[data-service-modal-next]");
    const idsHost = document.querySelector<HTMLElement>("[data-service-ids]");
    const ids = (idsHost?.dataset.serviceIds ?? "").split(",").filter(Boolean);
    const displaySelect = document.querySelector<HTMLSelectElement>("[data-display-select]");
    if (!modal || !content || !closeBtn || !prevBtn || !nextBtn || !ids.length) return;

    let currentId: string | null = null;

    function triggerFundAnim(root: Element) {
      const els = root.querySelectorAll(".fund-anim");
      if (!els.length) return;
      els.forEach((el) => el.classList.remove("in-view"));
      void (root as HTMLElement).offsetWidth;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          els.forEach((el) => el.classList.add("in-view"));
        });
      });
    }

    function bodyHtmlFor(id: string): string {
      const source = document.querySelector<HTMLElement>(
        `[data-desktop-content="${id}"], [data-panel-body="${id}"], [data-row-panel-body="${id}"]`,
      );
      return source ? source.innerHTML : "";
    }

    function renderId(id: string) {
      currentId = id;
      content!.innerHTML = bodyHtmlFor(id);
      content!.scrollTop = 0;
      triggerFundAnim(content!);
    }

    function openModal(id: string) {
      renderId(id);
      modal!.classList.remove("hidden");
      void modal!.offsetWidth;
      modal!.classList.add("is-open");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modal!.classList.remove("is-open");
      document.body.style.overflow = "";
      window.setTimeout(() => {
        if (!modal!.classList.contains("is-open")) modal!.classList.add("hidden");
      }, 300);
      currentId = null;
    }

    function step(delta: number) {
      if (!currentId) return;
      const idx = ids.indexOf(currentId);
      if (idx === -1) return;
      renderId(ids[(idx + delta + ids.length) % ids.length]);
    }

    closeBtn.addEventListener("click", closeModal);
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (modal!.classList.contains("hidden")) return;
      if (e.key === "Escape") closeModal();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });

    function isPopupMode() {
      return displaySelect?.value === "popup" && window.matchMedia("(min-width: 768px)").matches;
    }

    document.addEventListener(
      "click",
      (e) => {
        if (!isPopupMode()) return;
        const card = (e.target as HTMLElement).closest<HTMLElement>("[data-card], [data-panel], [data-scroll-card]");
        if (!card) return;
        const id = card.dataset.card || card.dataset.panel || card.dataset.scrollCard;
        if (!id) return;
        e.preventDefault();
        e.stopPropagation();
        openModal(id);
      },
      true,
    );

    // Popup mode is desktop-only (same scope as the display-mode dropdown
    // itself); drop back below the breakpoint and any open modal should
    // close rather than get stranded.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (!e.matches) closeModal();
    });
  })();
</script>

<script>
  // Capabilities layout switcher (Investment Banking, desktop only): the
  // dropdown picks which of the three card views is visible. On mobile,
  // clear any inline override so each component's own responsive classes
  // decide as before — ServicePanel's mobile accordion always shows there
  // regardless of the desktop-selected layout.
  const select = document.querySelector<HTMLSelectElement>("[data-layout-select]");
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-layout-panel]"));
  if (select && panels.length) {
    const mq = window.matchMedia("(min-width: 768px)");

    function applyLayout() {
      const value = select!.value;
      panels.forEach((panel) => {
        panel.style.display = mq.matches ? (panel.dataset.layoutPanel === value ? "" : "none") : "";
      });
    }

    select.addEventListener("change", applyLayout);
    mq.addEventListener("change", applyLayout);
    applyLayout();
  }
</script>
