---
// Consolidates the THREE separate copies of the panel-toggle JavaScript
// previously duplicated in IB.html (toggleIBPanel/toggleIBMobile),
// "Wealth Management.html" (toggleWMPanel/toggleWMMobile), and
// "Insurance Page.html" (toggleInsurancePanel/toggleInsuranceMobile) into
// one generic, data-driven component. The three copies differed only in
// column count (3 for IB/WM, 2 for Insurance) — the rest of the original
// per-page variation (expanded card height/scale, shrunk siblings) has been
// replaced by a single behavior: clicking a card opens its content as a
// full-width panel directly below that card's row, and the grid itself
// never reflows.
//
// Accessibility fix: the original trigger elements were `<div onclick="">`
// with no keyboard support. They're real <button> elements here, which
// gives native keyboard (Enter/Space) and focus support for free, plus
// aria-expanded/aria-controls wired to the panel/accordion state.
export interface ServicePanelItem {
  id: string;
  title: string;
  desc: string;
  /** A ready-to-use URL — callers pass astro:assets' getImage().src, which is already correctly encoded. Do NOT run this through encodeURI() below; that double-encodes it and breaks the image. */
  image: string;
  imagePosition?: "center" | "right";
  /**
   * Rendered HTML for the panel/accordion body shown when this card is
   * expanded. Passed as data (not a named slot) because callers build a
   * variable-length, Sanity-driven items array — a `.map()` producing
   * `<Fragment slot={...}>` per item hits an Astro compiler limitation
   * where the loop variable falls out of scope inside the slot content.
   */
  bodyHtml?: string;
}

export interface Props {
  items: ServicePanelItem[];
  columns?: 2 | 3;
  capabilitiesHeading?: string;
}

const { items, columns = 3, capabilitiesHeading = "Capabilities" } = Astro.props;

const panelId = `sp-${Math.random().toString(36).slice(2, 9)}`;
const colsClass = columns === 2 ? "md:grid-cols-2" : "md:grid-cols-3";
---

{
  capabilitiesHeading && (
    <h3 id={`${panelId}-capabilities-heading`} class="font-headline-lg text-headline-lg text-primary mb-4">
      {capabilitiesHeading}
    </h3>
  )
}
<div class="relative w-full" data-service-panel={panelId} data-heading-id={`${panelId}-capabilities-heading`}>
  <!-- Desktop Grid View. The clicked card stays exactly where it is — no
       resizing, no reordering — and the detail panel below is a normal grid
       item that JS moves to sit right after the last card of that card's
       row, spanning the full row width, so it reads as "content opening
       below the card" without ever reflowing the grid around it. -->
  <div class:list={["hidden md:grid gap-6 mb-8", colsClass]} data-desktop-grid data-columns={columns}>
    {
      items.map((item) => (
        <button
          type="button"
          id={`service-${item.id}`}
          class="relative overflow-hidden rounded-xl group h-[400px] border border-outline-variant/30 transition-all duration-300 text-left w-full appearance-none p-0"
          data-card={item.id}
          aria-expanded="false"
          aria-controls={`${panelId}-desktop-panel-content`}
        >
          <div
            class:list={[
              "absolute inset-0 bg-cover transition-transform duration-700 group-hover:scale-[1.04]",
              item.imagePosition === "right" ? "bg-right" : "bg-center",
            ]}
            style={`background-image:url("${item.image}")`}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 from-0% to-transparent to-55%" />
          <div class="absolute inset-0 p-8 flex flex-col justify-end">
            <h3 class="font-headline-md text-[24px] leading-[32px] text-on-primary mb-2">{item.title}</h3>
            <p class="font-body-sm text-body-sm text-surface-dim">{item.desc}</p>
            <div class="absolute bottom-8 right-8 flex items-center gap-2 text-on-primary">
              <span class="opacity-0 group-hover:opacity-100 transition-opacity font-cta-text text-sm">Learn more</span>
              <span class="material-symbols-outlined">arrow_forward</span>
            </div>
          </div>
        </button>
      ))
    }

    <div class="hidden" data-desktop-panel style="grid-column: 1 / -1;">
      <div class="rounded-xl border border-outline-variant/30 bg-surface-container-lowest shadow-lg p-8 relative">
        <button
          type="button"
          class="absolute top-6 right-6 text-on-surface-variant hover:text-primary"
          data-close-btn
          aria-label="Close"
        >
          <span class="material-symbols-outlined">close</span>
        </button>
        <div id={`${panelId}-desktop-panel-content`} data-desktop-panel-content>
          {
            items.map((item) => (
              <div class="hidden" data-desktop-content={item.id} set:html={item.bodyHtml} />
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Accordion View -->
  <div class="md:hidden flex flex-col gap-4" data-mobile-accordion>
    {
      items.map((item) => (
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 overflow-hidden" style="overflow-anchor: none;">
          <button
            type="button"
            class="flex items-stretch w-full text-left min-h-24 appearance-none p-0 bg-transparent"
            data-mobile-trigger={item.id}
            aria-expanded="false"
            aria-controls={`${panelId}-mobile-content-${item.id}`}
          >
            <img
              class:list={["w-24 h-24 object-cover flex-shrink-0 self-stretch", item.imagePosition === "right" && "object-right"]}
              src={item.image}
              alt={item.title}
            />
            <span class="flex items-center flex-grow min-w-0 gap-2 p-4">
              <span class="flex-grow min-w-0 text-left">
                <span class="block font-headline-md text-base text-primary truncate">{item.title}</span>
                <span class="block text-sm text-on-surface-variant truncate">{item.desc}</span>
              </span>
              <span class="material-symbols-outlined text-primary flex-shrink-0" data-mobile-icon={item.id}>add</span>
            </span>
          </button>
          <div
            class="hidden px-4 pt-4 pb-6 animate-fade-in"
            id={`${panelId}-mobile-content-${item.id}`}
            data-mobile-content={item.id}
            set:html={item.bodyHtml}
          />
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  /* Staggered entrance for panel body content — ported from IB.html's
     .fund-anim/.fund-point rules (only IB used them; harmless no-op for
     panel content that doesn't include these classes). Any body content
     passed into a `panel-*` slot can opt in by using them. Marked
     is:global because slotted content keeps the parent page's scope, not
     this component's. */
  .fund-anim {
    opacity: 0;
    transform: translateY(36px) scale(0.97);
    filter: blur(4px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fund-anim.in-view {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
  .fund-anim-1 { transition-delay: 0.05s; }
  .fund-anim-2 { transition-delay: 0.2s; }
  .fund-anim-3 { transition-delay: 0.35s; }
  .fund-anim-4 { transition-delay: 0.5s; }

  .fund-point {
    transition: background-color 0.2s ease-out;
  }
  .fund-point:hover {
    background-color: rgba(43, 88, 122, 0.06);
  }

  /* animate-fade-in is applied by this component's own script (to the
     desktop panel and each mobile accordion body on open) — ported from
     IB.html's copy since all three source pages defined it identically. */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fadeIn 0.4s ease-out forwards;
  }

  /* Subtle "this card is open" indicator — a border/shadow change only, so
     the grid never reflows or resizes around the active card. */
  [data-card][aria-expanded="true"] {
    border-color: var(--color-primary-light);
    box-shadow: 0 12px 28px rgba(18, 59, 93, 0.18);
  }
</style>

<script>
  function triggerFundAnim(root: Element) {
    const els = root.querySelectorAll(".fund-anim");
    if (!els.length) return;
    els.forEach((el) => el.classList.remove("in-view"));
    void (root as HTMLElement).offsetWidth;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        els.forEach((el) => el.classList.add("in-view"));
      });
    });
  }

  function initServicePanel(root: HTMLElement) {
    const grid = root.querySelector<HTMLElement>("[data-desktop-grid]");
    const desktopPanel = root.querySelector<HTMLElement>("[data-desktop-panel]");
    const closeBtn = root.querySelector<HTMLElement>("[data-close-btn]");
    if (!grid || !desktopPanel || !closeBtn) return;

    const columns = Number(grid.dataset.columns) || 3;
    let activeType: string | null = null;
    let activeCard: HTMLElement | null = null;
    let activeMobile: string | null = null;

    function setDesktopContent(type: string) {
      desktopPanel!.querySelectorAll("[data-desktop-content]").forEach((el) => {
        el.classList.toggle("hidden", el.getAttribute("data-desktop-content") !== type);
      });
      const shown = desktopPanel!.querySelector(`[data-desktop-content="${type}"]`);
      if (shown) triggerFundAnim(shown);
    }

    // Moves the (single, reused) detail panel node to sit immediately after
    // the last card of the clicked card's row, so it always renders as a
    // full-width strip directly below that row rather than mid-row (which
    // would leave a gap where the following cards used to be).
    function movePanelAfterCardRow(card: HTMLElement) {
      const cards = Array.from(grid!.querySelectorAll<HTMLElement>("[data-card]"));
      const idx = cards.indexOf(card);
      if (idx === -1) return;
      const rowEndIdx = Math.min(cards.length, (Math.floor(idx / columns) + 1) * columns) - 1;
      const referenceCard = cards[rowEndIdx + 1] ?? null;
      grid!.insertBefore(desktopPanel!, referenceCard);
    }

    function openPanel(type: string) {
      const clickedCard = grid!.querySelector<HTMLElement>(`[data-card="${type}"]`);
      if (!clickedCard) return;

      activeCard?.setAttribute("aria-expanded", "false");
      clickedCard.setAttribute("aria-expanded", "true");
      activeCard = clickedCard;

      setDesktopContent(type);
      movePanelAfterCardRow(clickedCard);

      desktopPanel!.classList.remove("hidden");
      desktopPanel!.classList.remove("animate-fade-in");
      void desktopPanel!.offsetWidth;
      desktopPanel!.classList.add("animate-fade-in");

      activeType = type;
      desktopPanel!.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function closePanel() {
      activeCard?.setAttribute("aria-expanded", "false");
      activeCard = null;
      desktopPanel!.classList.add("hidden");
      desktopPanel!.classList.remove("animate-fade-in");
      activeType = null;
    }

    root.querySelectorAll<HTMLElement>("[data-card]").forEach((card) => {
      card.addEventListener("click", () => {
        const type = card.dataset.card!;
        if (activeType === type) {
          closePanel();
        } else {
          openPanel(type);
        }
      });
    });

    closeBtn.addEventListener("click", closePanel);

    root.querySelectorAll<HTMLElement>("[data-mobile-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const type = trigger.dataset.mobileTrigger!;
        const beforeY = trigger.getBoundingClientRect().top;
        const content = root.querySelector<HTMLElement>(`[data-mobile-content="${type}"]`);
        const icon = root.querySelector<HTMLElement>(`[data-mobile-icon="${type}"]`);
        if (!content || !icon) return;

        if (activeMobile === type) {
          content.classList.add("hidden");
          icon.textContent = "add";
          trigger.setAttribute("aria-expanded", "false");
          activeMobile = null;
        } else {
          if (activeMobile) {
            root.querySelector(`[data-mobile-content="${activeMobile}"]`)?.classList.add("hidden");
            const prevIcon = root.querySelector(`[data-mobile-icon="${activeMobile}"]`);
            if (prevIcon) prevIcon.textContent = "add";
            root.querySelector(`[data-mobile-trigger="${activeMobile}"]`)?.setAttribute("aria-expanded", "false");
          }
          content.classList.remove("hidden");
          icon.textContent = "remove";
          trigger.setAttribute("aria-expanded", "true");
          activeMobile = type;
          triggerFundAnim(content);
        }

        const afterY = trigger.getBoundingClientRect().top;
        window.scrollBy(0, afterY - beforeY);
      });
    });

    // Header service links use these anchors. Opening the corresponding
    // card makes the destination useful rather than merely landing at the
    // capabilities section.
    function openServiceFromHash() {
      const match = window.location.hash.match(/^#service-(.+)$/);
      if (!match) return;
      const type = decodeURIComponent(match[1]);

      if (window.matchMedia("(min-width: 768px)").matches) {
        openPanel(type);
      } else {
        root.querySelector<HTMLElement>(`[data-mobile-trigger="${type}"]`)?.click();
      }
    }

    window.addEventListener("hashchange", openServiceFromHash);
    requestAnimationFrame(openServiceFromHash);
  }

  document.querySelectorAll<HTMLElement>("[data-service-panel]").forEach(initServicePanel);
</script>
