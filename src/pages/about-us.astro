          <button aria-label="Scroll left" class="founder-scroll-btn md:hidden absolute left-1 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-8 h-8 rounded-full bg-primary/80 text-white shadow-md" data-scroll-dir="-1" data-scroll-target="about-founder-cards" type="button"><span class="material-symbols-outlined text-lg">chevron_left</span></button>
          <button aria-label="Scroll right" class="founder-scroll-btn md:hidden absolute right-1 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-8 h-8 rounded-full bg-primary/80 text-white shadow-md" data-scroll-dir="1" data-scroll-target="about-founder-cards" type="button"><span class="material-symbols-outlined text-lg">chevron_right</span></button>
